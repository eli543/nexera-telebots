{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${TELEGRAM_STATE_DIR:-}\" ]; then python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/tg-stream.py\" pre; fi",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "mcp__plugin_telegram_telegram__reply",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${TELEGRAM_STATE_DIR:-}\" ]; then python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/tldr-nudge.py\"; fi",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${TELEGRAM_STATE_DIR:-}\" ]; then python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/tg-stream.py\" post; fi",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${TELEGRAM_STATE_DIR:-}\" ]; then python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/tg-deliver-nudge.py\"; fi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plugin_telegram_telegram__reply",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${TELEGRAM_STATE_DIR:-}\" ]; then python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/tg-reply-guard.py\" reply; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${TELEGRAM_STATE_DIR:-}\" ]; then python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/tg-stream.py\" stop; fi",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${TELEGRAM_STATE_DIR:-}\" ]; then python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/tg-reply-guard.py\" stop; fi",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${TELEGRAM_STATE_DIR:-}\" ]; then bash \"${CLAUDE_PLUGIN_ROOT}/hooks/context-guardian.sh\"; fi",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${TELEGRAM_STATE_DIR:-}\" ]; then python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/telegram-ack.py\"; fi",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${TELEGRAM_STATE_DIR:-}\" ]; then bash \"${CLAUDE_PLUGIN_ROOT}/hooks/telegram-fresh.sh\"; fi",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${TELEGRAM_STATE_DIR:-}\" ]; then bash \"${CLAUDE_PLUGIN_ROOT}/hooks/telegram-resume.sh\"; fi",
            "timeout": 25
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${TELEGRAM_STATE_DIR:-}\" ]; then bash \"${CLAUDE_PLUGIN_ROOT}/hooks/telegram-model.sh\"; fi",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${TELEGRAM_STATE_DIR:-}\" ]; then python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/tg-stream.py\" prompt; fi",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${TELEGRAM_STATE_DIR:-}\" ]; then python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/tg-reply-guard.py\" prompt; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${TELEGRAM_STATE_DIR:-}\" ]; then bash \"${CLAUDE_PLUGIN_ROOT}/hooks/compact-notify.sh\" pre; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${TELEGRAM_STATE_DIR:-}\" ]; then bash \"${CLAUDE_PLUGIN_ROOT}/hooks/record-session-id.sh\"; fi",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${TELEGRAM_STATE_DIR:-}\" ]; then bash \"${CLAUDE_PLUGIN_ROOT}/hooks/telebots-rules.sh\"; fi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${TELEGRAM_STATE_DIR:-}\" ]; then bash \"${CLAUDE_PLUGIN_ROOT}/hooks/compact-notify.sh\" post; fi",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
