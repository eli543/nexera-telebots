#!/usr/bin/env bash
# No real host command is reached by a sandbox test.
set -euo pipefail
name="${0##*/}"
printf '%s\n' "$name" >> "${TELEBOTS_SHIM_LOG:?}"
case "$name" in
  claude)
    if [ "${1:-}" = "--version" ]; then printf '2.1.286\n'; exit 0; fi
    if [ "${1:-}" = "plugin" ]; then exit 0; fi
    ;;
  bun)
    if [ "${1:-}" = "--version" ]; then printf '1.4.2\n'; exit 0; fi
    ;;
  uname)
    if [ "${1:-}" = "-s" ]; then printf '%s\n' "${TELEBOTS_FAKE_UNAME:-Darwin}"; exit 0; fi
    if [ "${1:-}" = "-m" ]; then printf 'arm64\n'; exit 0; fi
    ;;
  sw_vers)
    if [ "${1:-}" = "-productVersion" ]; then printf '14.0\n'; exit 0; fi
    ;;
  launchctl)
    # A blocked bootout is considered successful so uninstall can continue.
    exit 0 ;;
esac
printf 'Sandbox blocked %s\n' "$name" >&2
exit 65
