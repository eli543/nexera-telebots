#!/usr/bin/env python3
"""Transcribe an audio file to text with faster-whisper (cross-platform, CPU or GPU).

Usage: transcribe-voice-faster <audio-path> [language]
Prints ONLY the transcript to stdout; all diagnostics go to stderr.

This is the fallback transcriber for machines that are not Apple Silicon (where
transcribe-voice-mlx is faster). faster-whisper is a third-party package, not
part of the Python standard library. Install it with:

    pip install faster-whisper

Env overrides:
    TRANSCRIBE_MODEL   whisper model size or path (default "large-v3")
    TRANSCRIBE_COMPUTE compute type (default "int8"; e.g. "float16" on GPU)
"""
import os
import sys


def main():
    args = sys.argv[1:]
    if not args:
        sys.stderr.write("usage: transcribe-voice-faster <audio-path> [language]\n")
        return 2

    audio = args[0]
    language = args[1] if len(args) > 1 else "en"

    if not os.path.isfile(audio):
        sys.stderr.write("transcribe-voice-faster: file not found: %s\n" % audio)
        return 1

    try:
        from faster_whisper import WhisperModel
    except ImportError:
        sys.stderr.write(
            "transcribe-voice-faster: faster-whisper is not installed.\n"
            "Install it with: pip install faster-whisper\n"
            "(On Apple Silicon, transcribe-voice-mlx is the faster default.)\n"
        )
        return 127

    model_name = os.environ.get("TRANSCRIBE_MODEL", "large-v3")
    compute_type = os.environ.get("TRANSCRIBE_COMPUTE", "int8")

    try:
        model = WhisperModel(model_name, compute_type=compute_type)
        segments, _info = model.transcribe(audio, language=language)
        text = "".join(segment.text for segment in segments).strip()
    except Exception as exc:  # report any backend error clearly, then fail
        sys.stderr.write("transcribe-voice-faster: transcription failed: %s\n" % exc)
        return 1

    sys.stdout.write(text + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
