+// -- mid-task restart support -----------------------------------------------
+// Restart or reconfigure THIS bot's claude session on a bare "/fresh" (and, with
+// patch 05, "/model ..."), even mid-task. Those commands were originally handled
+// only by UserPromptSubmit hooks, which fire ONLY when claude is idle: a command
+// arriving mid-turn is folded into the running turn and the hook never runs. This
+// server sees every inbound message BEFORE Claude Code's idle-vs-busy split, so
+// handling the command here makes it work in both cases. The idle hook stays as a
+// harmless fallback (when this intercept runs we never forward the command).
+//
+// Safety: we only restart the claude process that spawned THIS server (found by
+// walking our own parent chain) and hand the restart script that pid plus this
+// bot's workdir. fleet-fresh independently refuses unless the pid is a claude
+// whose cwd matches that workdir, so a wrong pid is a safe no-op and a sibling bot
+// can never be killed.
+//
+// No bot list is hardcoded: the fleet is described entirely by fleet.json. We read
+// $FLEET_CONFIG (default $FLEET_HOME/fleet.json) and resolve this bot's workdir by
+// matching its state_dir against ours, at call time (a live config edit is picked
+// up without restarting the poller). Missing or unreadable config yields a
+// graceful "can't restart automatically" reply, never a crash.
+
+const FLEET_HOME = process.env.FLEET_HOME ?? join(homedir(), '.claude', 'telegram-fleet')
+const FLEET_CONFIG = process.env.FLEET_CONFIG ?? join(FLEET_HOME, 'fleet.json')
+const FRESH_RESTART_SCRIPT = join(FLEET_HOME, 'bin', 'fleet-fresh')
+const FRESH_LOG = join(STATE_DIR, 'logs', 'fresh.log')
+
+// POSIX single-quote a string so it is ONE safe literal argv when interpolated
+// into a `/bin/sh -c` command line. Command args come from Telegram text, so they
+// must never be able to break out of the argument (e.g. "; rm -rf").
+function shq(s: string): string {
+  return `'${s.replace(/'/g, `'\\''`)}'`
+}
+
+// Expand a leading "~" (or "~/...") in a configured path to an absolute path.
+function expandTilde(p: string): string {
+  if (p === '~') return homedir()
+  if (p.startsWith('~/')) return join(homedir(), p.slice(2))
+  return p
 }
 
+// Resolve THIS bot's workdir from fleet.json by matching its state_dir against
+// STATE_DIR. Returns the absolute workdir, or null when the config is missing,
+// unreadable, malformed, or has no bot for this state dir.
+function resolveWorkdir(): string | null {
+  const norm = (p: string) => p.replace(/\/+$/, '')
+  let cfg: any
+  try {
+    cfg = JSON.parse(readFileSync(FLEET_CONFIG, 'utf8'))
+  } catch {
+    return null
+  }
+  const bots = Array.isArray(cfg?.bots) ? cfg.bots : []
+  const want = norm(STATE_DIR)
+  for (const b of bots) {
+    if (b && typeof b.state_dir === 'string' && norm(expandTilde(b.state_dir)) === want) {
+      return typeof b.workdir === 'string' && b.workdir ? expandTilde(b.workdir) : null
+    }
+  }
+  return null
+}
+
+function freshLog(line: string): void {
+  try {
+    mkdirSync(join(STATE_DIR, 'logs'), { recursive: true, mode: 0o700 })
+    writeFileSync(FRESH_LOG, `${new Date().toISOString()} ${line}\n`, { flag: 'a' })
+  } catch {}
+}
+
+// Walk the parent chain to find the claude process that spawned this MCP server.
+// server.ts is launched by `claude` via a `bun run` wrapper, so claude is always
+// an ancestor. We match on the unique "--channels plugin:telegram" arg: the bun
+// wrapper's path also contains the substring "claude" (.../.claude/plugins/...),
+// so a name check alone is ambiguous, but only the real claude process carries
+// that flag. Returns null if not found within a few hops.
+function findOwningClaudePid(): number | null {
+  let pid = process.ppid
+  for (let i = 0; i < 6 && pid > 1; i++) {
+    let out = ''
+    try {
+      out = Bun.spawnSync(['ps', '-o', 'ppid=,command=', '-p', String(pid)]).stdout.toString().trim()
+    } catch {
+      break
+    }
+    if (!out) break
+    const sp = out.indexOf(' ')
+    if (sp < 0) break
+    const parentPid = parseInt(out.slice(0, sp), 10)
+    const cmd = out.slice(sp + 1)
+    if (cmd.includes('--channels') && cmd.includes('plugin:telegram')) return pid
+    if (!Number.isFinite(parentPid)) break
+    pid = parentPid
+  }
+  return null
+}
+
+// Handle a bare "/fresh": ack, then spawn the detached restart of this bot's
+// session. Spawned via `nohup ... & disown` through a shell so the restart
+// outlives this server (which dies when its claude is SIGTERMed). macOS ships no
+// setsid; this is the same detach the idle hook uses.
+async function handleFresh(chat_id: string): Promise<void> {
+  const cwd = resolveWorkdir()
+  const claudePid = findOwningClaudePid()
+  freshLog(`SERVER-FRESH state=${STATE_DIR} cwd=${cwd ?? '?'} claudePid=${claudePid ?? '?'} chat=${chat_id}`)
+
+  if (!cwd || !claudePid) {
+    process.stderr.write(
+      `telegram channel: /fresh could not resolve restart target (cwd=${cwd} pid=${claudePid})\n`,
+    )
+    await bot.api
+      .sendMessage(
+        chat_id,
+        cwd
+          ? 'Could not find this session to restart - do it from the terminal.'
+          : 'Fleet config missing or this bot is not listed in it - could not restart automatically. Restart from the terminal.',
+      )
+      .catch(() => {})
+    return
+  }
+
+  await bot.api.sendMessage(chat_id, 'Starting fresh session... back in ~5s.').catch(() => {})
+  try {
+    Bun.spawn(
+      ['/bin/sh', '-c', `nohup ${shq(FRESH_RESTART_SCRIPT)} ${claudePid} ${shq(cwd)} </dev/null >>${shq(FRESH_LOG)} 2>&1 & disown`],
+      { stdin: 'ignore', stdout: 'ignore', stderr: 'ignore' },
+    ).unref()
+    freshLog(`SERVER-FRESH spawned restart pid-arg=${claudePid} cwd-arg=${cwd}`)
+  } catch (err) {
+    process.stderr.write(`telegram channel: /fresh restart spawn failed: ${err}\n`)
+    freshLog(`SERVER-FRESH spawn FAILED: ${err}`)
+    await bot.api
+      .sendMessage(chat_id, 'Fresh restart failed to launch - restart from the terminal.')
+      .catch(() => {})
+  }
+}
