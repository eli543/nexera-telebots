+// The /model command handler: parse, validate, write per-bot model state, then
+// restart-with-resume. Hands off to the fleet-model engine - the same engine the
+// idle /model hook calls - so the mid-task path here and the idle path can never
+// drift. The engine sends its own reply (report / switch ack / rejection) and
+// owns the restart, so this only resolves the workdir, spawns detached, and logs.
+// Args are passed through safely single-quoted; the engine lowercases and
+// whitelists them.
+const MODEL_SCRIPT = join(FLEET_HOME, 'bin', 'fleet-model')
+const MODEL_LOG = join(STATE_DIR, 'logs', 'model.log')
+
+async function handleModel(chat_id: string, args: string): Promise<void> {
+  const cwd = resolveWorkdir()
+  freshLog(`SERVER-MODEL state=${STATE_DIR} cwd=${cwd ?? '?'} args=${JSON.stringify(args)} chat=${chat_id}`)
+
+  if (!cwd) {
+    await bot.api
+      .sendMessage(
+        chat_id,
+        'Fleet config missing or this bot is not listed in it - could not switch model. Set it from the terminal.',
+      )
+      .catch(() => {})
+    return
+  }
+
+  try {
+    Bun.spawn(
+      ['/bin/sh', '-c', `nohup ${shq(MODEL_SCRIPT)} ${shq(cwd)} ${shq(chat_id)} ${shq(args)} </dev/null >>${shq(MODEL_LOG)} 2>&1 & disown`],
+      { stdin: 'ignore', stdout: 'ignore', stderr: 'ignore' },
+    ).unref()
+    freshLog(`SERVER-MODEL spawned handler cwd-arg=${cwd} args=${JSON.stringify(args)}`)
+  } catch (err) {
+    process.stderr.write(`telegram channel: /model handler spawn failed: ${err}\n`)
+    freshLog(`SERVER-MODEL spawn FAILED: ${err}`)
+    await bot.api
+      .sendMessage(chat_id, 'Model switch failed to launch - set it from the terminal.')
       .catch(() => {})
   }
 }
