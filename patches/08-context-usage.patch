+// The /context command handler: report this session's live context usage (used
+// tokens vs the window cap, with a bar) into the chat. The fleet-context engine
+// reads the newest usage record in this bot's session transcript and sends the
+// report itself with the bot's own token, entirely OUTSIDE the model - so it
+// works mid-task and costs the session zero context. This only resolves the
+// workdir, spawns detached, and logs.
+const CONTEXT_SCRIPT = join(FLEET_HOME, 'bin', 'fleet-context')
+const CONTEXT_LOG = join(STATE_DIR, 'logs', 'context.log')
+
+async function handleContext(chat_id: string): Promise<void> {
+  const cwd = resolveWorkdir()
+  freshLog(`SERVER-CONTEXT state=${STATE_DIR} cwd=${cwd ?? '?'} chat=${chat_id}`)
 
+  if (!cwd) {
+    await bot.api
+      .sendMessage(
+        chat_id,
+        'Fleet config missing or this bot is not listed in it - could not read context. Check from the terminal.',
+      )
+      .catch(() => {})
+    return
+  }
+
+  try {
+    Bun.spawn(
+      ['/bin/sh', '-c', `nohup ${shq(CONTEXT_SCRIPT)} ${shq(cwd)} ${shq(chat_id)} </dev/null >>${shq(CONTEXT_LOG)} 2>&1 & disown`],
+      { stdin: 'ignore', stdout: 'ignore', stderr: 'ignore' },
+    ).unref()
+    freshLog(`SERVER-CONTEXT spawned engine cwd-arg=${cwd}`)
+  } catch (err) {
+    process.stderr.write(`telegram channel: /context engine spawn failed: ${err}\n`)
+    freshLog(`SERVER-CONTEXT spawn FAILED: ${err}`)
+    await bot.api
+      .sendMessage(chat_id, 'Context report failed to launch - check from the terminal.')
+      .catch(() => {})
+  }
+}
