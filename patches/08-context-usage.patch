+// The /usage command handler: fleet-wide token burn measured from every bot's
+// session transcripts (today plus the trailing 7 days, per bot, with a model
+// split). Same outside-the-model pattern as /context: the fleet-usage engine
+// computes the numbers and sends the report itself.
+const USAGE_SCRIPT = join(FLEET_HOME, 'bin', 'fleet-usage')
+const USAGE_LOG = join(STATE_DIR, 'logs', 'usage.log')
+
+async function handleUsage(chat_id: string): Promise<void> {
+  const cwd = resolveWorkdir()
+  freshLog(`SERVER-USAGE state=${STATE_DIR} cwd=${cwd ?? '?'} chat=${chat_id}`)
+
+  if (!cwd) {
+    await bot.api
+      .sendMessage(
+        chat_id,
+        'Fleet config missing or this bot is not listed in it - could not read usage. Check from the terminal.',
+      )
+      .catch(() => {})
+    return
+  }
+
+  try {
+    Bun.spawn(
+      ['/bin/sh', '-c', `nohup ${shq(USAGE_SCRIPT)} ${shq(cwd)} ${shq(chat_id)} </dev/null >>${shq(USAGE_LOG)} 2>&1 & disown`],
+      { stdin: 'ignore', stdout: 'ignore', stderr: 'ignore' },
+    ).unref()
+    freshLog(`SERVER-USAGE spawned engine cwd-arg=${cwd}`)
+  } catch (err) {
+    process.stderr.write(`telegram channel: /usage engine spawn failed: ${err}\n`)
+    freshLog(`SERVER-USAGE spawn FAILED: ${err}`)
+    await bot.api
+      .sendMessage(chat_id, 'Usage report failed to launch - check from the terminal.')
+      .catch(() => {})
+  }
+}
