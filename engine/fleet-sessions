#!/usr/bin/env python3
"""List and reopen chats across the configured bots.

Commands:
  render [--limit 20] [--exclude-uuid U] [--bot KEY] [--style inline|reply|plain]
  list [--limit 12] [--exclude-uuid U] [--bot KEY]
  resolve N [--bot KEY] [--gen TOKEN]
  resolve-uuid U [--bot KEY]

render prints JSON with text, reply_markup, count and style. Inline buttons
use rs:<uuid>; controls use rsx:refresh and rsx:close.
Exit codes: 0 success, 1 render failed, 2 invalid arguments, 3 no saved list,
4 no such session, 5 stale list, 6 unreadable transcript.
"""

import concurrent.futures
import glob
import html
import json
import os
from pathlib import Path
import re
import secrets
import subprocess
import sys
import tempfile
import time
import urllib.parse
import urllib.request


HOME = Path.home()
FLEET_HOME = Path(os.environ.get("FLEET_HOME", "~/.claude/telegram-fleet")).expanduser()
SELF_DIR = Path(__file__).resolve().parent
FC = FLEET_HOME / "bin" / "fleet-config"
if not os.access(FC, os.X_OK):
    FC = SELF_DIR / "fleet-config"
CACHE = FLEET_HOME / "resume-labels.json"
UUID_RE = re.compile(r"^[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$")
KEY_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,30}$")
LOW_INFO = re.compile(r"^(?:hi|hey|hello|thanks|thank you|ok|okay|yes|no|test|ping|help|start)[.!? ]*$", re.I)
TOKEN_RE = re.compile(r"[0-9]{8,10}:[A-Za-z0-9_-]{35,}")
KEY_SECRET_RE = re.compile(r"\b(?:sk-ant-|sk-proj-|sk-)[A-Za-z0-9_-]{12,}\b")
ASSIGNMENT_SECRET_RE = re.compile(r"(?i)\b(password|token|api[_ -]?key|secret)\s*[:=]\s*\S+")
STALE_AFTER = 6 * 3600
MAX_TEXT = 3900
BASIS = "opening-v3"


def fc(*args):
    try:
        proc = subprocess.run([str(FC), *args], text=True, capture_output=True, timeout=8)
        return proc.stdout.strip() if proc.returncode == 0 else ""
    except Exception:
        return ""


def bot_rows():
    rows = []
    for key in fc("bots").splitlines():
        if not KEY_RE.fullmatch(key):
            continue
        workdir = fc("bot", key, "workdir")
        if not workdir:
            continue
        rows.append({"key": key, "name": fc("bot", key, "name") or key,
                     "emoji": fc("bot", key, "emoji") or "•", "workdir": workdir,
                     "project": fc("project-dir", key)})
    return rows


def scrub(value):
    value = TOKEN_RE.sub("[redacted]", str(value))
    value = KEY_SECRET_RE.sub("[redacted]", value)
    value = ASSIGNMENT_SECRET_RE.sub(lambda m: m.group(1) + "=[redacted]", value)
    value = re.sub(r"<system-reminder>.*?</system-reminder>", "", value, flags=re.S)
    value = re.sub(r"\s+", " ", value).strip()
    return value


def msg_text(record):
    message = record.get("message")
    if not isinstance(message, dict):
        return ""
    content = message.get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(str(p.get("text", "")) for p in content
                         if isinstance(p, dict) and p.get("type") == "text")
    return ""


def substantive_user(raw):
    if not raw or "<command-name>" in raw or "<task-notification" in raw:
        return ""
    channel = re.search(r"<channel\b[^>]*>(.*?)</channel>", raw, re.S)
    text = channel.group(1) if channel else raw
    voice = re.search(r"(?:Transcript|Transcription):\s*(.+)", text, re.I | re.S)
    if voice:
        text = voice.group(1)
    text = re.sub(r"<[^>]+>", " ", text)
    text = scrub(text)
    if not text or text.startswith("/") or LOW_INFO.fullmatch(text):
        return ""
    if re.fullmatch(r"\(?\s*(?:voice|audio|photo|video|document)(?: message| note)?\s*\)?", text, re.I):
        return ""
    if text.startswith(("Base directory for this skill:", "Caveat:")):
        return ""
    return text


def opening(path):
    users = []
    reply = ""
    pending_voice = False
    try:
        with open(path, encoding="utf-8", errors="replace") as handle:
            for i, line in enumerate(handle):
                if i >= 1000 or len(users) >= 3:
                    break
                try:
                    record = json.loads(line)
                except ValueError:
                    continue
                kind = record.get("type")
                if kind == "user" and not record.get("isMeta") and not record.get("isCompactSummary"):
                    origin = record.get("origin")
                    if isinstance(origin, dict) and origin.get("kind") == "peer":
                        continue
                    raw = msg_text(record)
                    value = substantive_user(raw)
                    if value:
                        users.append(value)
                        pending_voice = False
                    elif "voice" in raw.lower() or "audio" in raw.lower():
                        pending_voice = True
                    if pending_voice and isinstance(record.get("message", {}).get("content"), list):
                        for part in record["message"]["content"]:
                            if isinstance(part, dict) and part.get("type") == "tool_result":
                                words = substantive_user(str(part.get("content", "")))
                                if words:
                                    users.append(words)
                                    pending_voice = False
                                    break
                elif kind == "assistant" and not reply:
                    message = record.get("message") or {}
                    for part in message.get("content", []) if isinstance(message.get("content"), list) else []:
                        if not isinstance(part, dict):
                            continue
                        if part.get("type") == "tool_use" and str(part.get("name", "")).endswith("__reply"):
                            reply = scrub((part.get("input") or {}).get("text", ""))
                            break
                    if not reply:
                        reply = scrub(msg_text(record))
    except OSError:
        return [], "", False
    return users, reply, len(users) >= 3


def shorten(text, cap=42):
    text = scrub(text)
    if len(text) <= cap:
        return text
    cut = text[:cap].rsplit(" ", 1)[0]
    return (cut if len(cut) >= cap // 2 else text[:cap]).rstrip(" ,.;:-") + "…"


def heuristic(users, reply):
    if not users:
        return "New conversation"
    first = users[0]
    if len(first) < 15 and reply:
        return shorten(first + " - " + reply, 42)
    return shorten(first, 42)


def api_key():
    direct = os.environ.get("ANTHROPIC_API_KEY_TLDR", "").strip()
    if direct:
        return direct
    if fc("option", "tldr_judge") != "true":
        return ""
    try:
        result = subprocess.run(["security", "find-generic-password", "-s", "nexera-telebots-judge", "-w"],
                                capture_output=True, text=True, timeout=5)
        return result.stdout.strip() if result.returncode == 0 else ""
    except Exception:
        return ""


def ai_label(key, users, reply):
    if not users:
        return ""
    endpoint = "https://api.anthropic.com/v1/messages"
    if os.environ.get("TELEBOTS_TEST") == "1":
        candidate = os.environ.get("TELEBOTS_ANTHROPIC_API_BASE", "")
        parsed = urllib.parse.urlparse(candidate)
        if parsed.scheme == "http" and parsed.hostname in ("127.0.0.1", "localhost", "::1"):
            endpoint = candidate.rstrip("/") + "/v1/messages"
    request = urllib.request.Request(endpoint, method="POST",
        data=json.dumps({"model": "claude-haiku-4-5", "max_tokens": 48,
                         "messages": [{"role": "user", "content":
                            "Name the main topic of this chat from its opening in 3 to 6 words. Reply with the topic only.\n"
                            + "\n".join(users[:3]) + "\nFirst reply: " + reply[:300]}]}).encode(),
        headers={"x-api-key": key, "anthropic-version": "2023-06-01", "content-type": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=8) as response:
            data = json.load(response)
        value = scrub(data["content"][0]["text"]).strip('". ')
        return value if 3 <= len(value) <= 70 and "\n" not in value else ""
    except Exception:
        return ""


def read_cache():
    try:
        data = json.loads(CACHE.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def atomic_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temp = tempfile.mkstemp(prefix="." + path.name + ".", dir=path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(value, handle, indent=2, ensure_ascii=False)
            handle.write("\n")
        os.replace(temp, path)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def gather(limit, exclude_uuid):
    candidates = []
    for bot in bot_rows():
        for src in glob.glob(os.path.join(bot["project"], "*.jsonl")):
            uuid = Path(src).stem
            if not UUID_RE.fullmatch(uuid) or uuid == exclude_uuid:
                continue
            try:
                if Path(src).resolve().parent != Path(bot["project"]).resolve():
                    continue
                if os.path.getsize(src) < 50:
                    continue
                candidates.append((os.path.getmtime(src), bot, src, uuid))
            except OSError:
                continue
    candidates.sort(reverse=True, key=lambda row: row[0])
    items, seen = [], set()
    for mtime, bot, src, uuid in candidates:
        if len(items) == limit:
            break
        if uuid in seen:
            continue
        users, reply, locked = opening(src)
        label = heuristic(users, reply)
        items.append({"n": len(items) + 1, "uuid": uuid, "worktree": bot["workdir"],
                      "persona": bot["name"], "emoji": bot["emoji"], "src": src,
                      "mtime": mtime, "label": label, "description": label,
                      "opening": users[:3], "first_reply": reply[:300], "locked": locked})
        seen.add(uuid)
    return items


def apply_labels(items):
    cache = read_cache()
    key = api_key()
    changed = False
    todo = []
    for item in items:
        old = cache.get(item["uuid"], {})
        if (old.get("basis") == BASIS and (old.get("locked") or old.get("mtime") == item["mtime"])
                and (not key or old.get("source") == "ai")):
            item["label"] = old.get("label") or item["label"]
        else:
            todo.append(item)
    ai_done = set()
    if key and todo:
        with concurrent.futures.ThreadPoolExecutor(max_workers=min(4, len(todo))) as pool:
            futures = {pool.submit(ai_label, key, it["opening"], it["first_reply"]): it for it in todo}
            for future in concurrent.futures.as_completed(futures):
                value = future.result()
                if value:
                    futures[future]["label"] = value
                    ai_done.add(futures[future]["uuid"])
    for item in todo:
        cache[item["uuid"]] = {"basis": BASIS, "label": item["label"],
                               "source": "ai" if item["uuid"] in ai_done else "heuristic",
                               "mtime": item["mtime"], "locked": item["locked"]}
        changed = True
    if changed:
        atomic_json(CACHE, cache)
    for item in items:
        item["description"] = item["label"]
        del item["opening"]
        del item["first_reply"]
        del item["locked"]


def state_file(bot):
    return FLEET_HOME / ("resume-list-" + bot + ".json" if bot else "resume-list.json")


def store_list(items, bot):
    token = secrets.token_hex(4)
    atomic_json(state_file(bot), {"generated": int(time.time()), "gen": token, "items": items})
    return token


def render_text(items):
    if not items:
        return "No recoverable sessions found across your bots yet."
    lines = ["<b>Your recent chats across your bots</b>", ""]
    for item in items:
        when = time.strftime("%a, %b %-d", time.localtime(item["mtime"]))
        lines.append(f"<b>{item['n']}. {html.escape(item['emoji'])} {html.escape(item['persona'])}</b> · {when}")
        lines.append("<i>" + html.escape(shorten(item["description"], 70)) + "</i>")
        lines.append("")
    lines.append("Tap a number to reopen it here, or reply /resume N.")
    text = "\n".join(lines)
    while len(text) > MAX_TEXT and len(items) > 1:
        items.pop()
        text = render_text(items)
    return text


def keyboard(items, style, gen):
    if style == "inline":
        rows, row = [], []
        for item in items:
            row.append({"text": f"{item['n']} {item['emoji']}", "callback_data": "rs:" + item["uuid"]})
            if len(row) == 4:
                rows.append(row); row = []
        if row:
            rows.append(row)
        rows.append([{"text": "🔄 Refresh", "callback_data": "rsx:refresh"},
                     {"text": "✕ Close", "callback_data": "rsx:close"}])
        return {"inline_keyboard": rows}
    if style == "reply":
        rows = [[{"text": f"/resume {it['n']} g{gen}"} for it in items[i:i + 3]]
                for i in range(0, len(items), 3)]
        return {"keyboard": rows, "resize_keyboard": True, "one_time_keyboard": True}
    return None


def do_render(limit, exclude_uuid, bot, style, text_only=False):
    items = gather(limit, exclude_uuid)
    apply_labels(items)
    text = render_text(items)
    gen = store_list(items, bot)
    if text_only:
        print(text)
    else:
        payload = {"text": text, "reply_markup": keyboard(items, style, gen),
                   "count": len(items), "style": style}
        print(json.dumps(payload, ensure_ascii=False))
    logs = FLEET_HOME / "logs"
    logs.mkdir(parents=True, exist_ok=True)
    with (logs / "sessions.log").open("a", encoding="utf-8") as handle:
        handle.write(time.strftime("%Y-%m-%dT%H:%M:%S%z") +
                     f" RENDER count={len(items)} labels={sum(bool(it['label']) for it in items)}\n")
    return 0


def resolve_number(value, bot, gen):
    try:
        data = json.loads(state_file(bot).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return 3
    if time.time() - float(data.get("generated", 0)) > STALE_AFTER or (gen and gen != data.get("gen")):
        return 5
    for item in data.get("items", []):
        if item.get("n") == value:
            print("\t".join(str(item.get(k, "")) for k in ("uuid", "worktree", "persona", "src")))
            return 0
    return 4


def resolve_uuid(value, bot):
    if not UUID_RE.fullmatch(value):
        return 2
    try:
        data = json.loads(state_file(bot).read_text(encoding="utf-8"))
        projects = {Path(row["project"]).resolve() for row in bot_rows()}
        for item in data.get("items", []):
            source = Path(str(item.get("src", ""))).resolve()
            if (item.get("uuid") == value and source.name == value + ".jsonl"
                    and source.parent in projects and source.is_file()):
                print("\t".join(str(item.get(k, "")) for k in ("uuid", "worktree", "persona", "src")))
                return 0
    except (OSError, ValueError):
        pass
    for row in bot_rows():
        path = Path(row["project"]) / (value + ".jsonl")
        if path.is_file() and path.resolve().parent == Path(row["project"]).resolve():
            try:
                with path.open("rb") as handle:
                    handle.read(1)
            except OSError:
                return 6
            print("\t".join((value, row["workdir"], row["name"], str(path))))
            return 0
    return 4


def main(argv):
    if not argv or argv[0] in ("--help", "-h"):
        print(__doc__.strip())
        return 0 if argv else 2
    bot = None
    if "--bot" in argv:
        index = argv.index("--bot")
        if index + 1 >= len(argv):
            return 2
        bot = argv[index + 1]
        del argv[index:index + 2]
        if bot not in {row["key"] for row in bot_rows()}:
            return 2
    cmd = argv.pop(0)
    if cmd in ("render", "list"):
        limit = 20 if cmd == "render" else 12
        exclude, style = None, "inline" if cmd == "render" else "plain"
        while argv:
            flag = argv.pop(0)
            if not argv:
                return 2
            value = argv.pop(0)
            if flag == "--limit":
                try:
                    limit = max(1, min(20, int(value)))
                except ValueError:
                    return 2
            elif flag == "--exclude-uuid":
                if not UUID_RE.fullmatch(value):
                    return 2
                exclude = value
            elif flag == "--style" and cmd == "render" and value in ("inline", "reply", "plain"):
                style = value
            else:
                return 2
        return do_render(limit, exclude, bot, style, cmd == "list")
    if cmd == "resolve":
        if not argv:
            return 2
        try:
            number = int(argv.pop(0))
        except ValueError:
            return 2
        gen = None
        if argv:
            if len(argv) != 2 or argv[0] != "--gen":
                return 2
            gen = argv[1].removeprefix("g")
        return resolve_number(number, bot, gen)
    if cmd == "resolve-uuid" and len(argv) == 1:
        return resolve_uuid(argv[0], bot)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
