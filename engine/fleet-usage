#!/bin/bash
# fleet-usage - report the user's PLAN LIMITS (how much is left) plus real token
# burn across the whole fleet, measured from the bots' session transcripts:
# today and the trailing 7 days, fleet totals plus a per-bot and per-model
# split. Runs entirely OUTSIDE the model - works mid-task and costs the session
# zero context. The bot list comes from fleet.json, so a bot added to the
# config is counted with no script edits.
#
# Plan limits come from the same source the terminal /usage screen uses: the
# api.anthropic.com/api/oauth/usage endpoint, called with the user's own Claude
# Code OAuth token, read at call time from the macOS Keychain (service
# "Claude Code-credentials" - the generic name Claude Code itself writes, so
# this works for any account with no configuration). The token lives in one
# shell variable for the duration of the fetch: never logged, never stored,
# never echoed. FAIL SOFT by design: no token, a non-200, or a parse failure
# degrades the limits section to a one-line notice and the burn section still
# reports. NOTE: that endpoint is undocumented and can change shape without
# warning - if it does, the parser degrades to the notice, never a crash.
#
# "Today" and all reset times use this machine's local timezone.
#
# Args:
#   $1  workdir of the CALLING bot (must be known to fleet.json; supplies the
#       token the report is sent with)
#   $2  chat_id to send the report to
#
# Auth posture: the poller's access gate() is the auth layer - only allowlisted
# senders' /usage ever reaches the spawn. Locally this script trusts its args,
# like every other engine here, and only ever SENDS a report (never acts).
#
# Env: CC_USAGE_DRYRUN=1 prints the report to the log instead of sending it.
# Python 3.9+, stdlib only. Logs to $FLEET_HOME/logs/usage.log.
# Exit codes: 0 report sent or dry run, 1 missing args, 2 unknown workdir,
# 3 empty fleet, 4 no bot token for delivery.

set -uo pipefail

usage() { sed -n '2,34p' "$0" | sed 's/^# \{0,1\}//'; }
case "${1:-}" in -h|--help) usage; exit 0 ;; esac

FLEET_HOME="${FLEET_HOME:-$HOME/.claude/telegram-fleet}"
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
resolve_bin() {
  if [ -x "$FLEET_HOME/bin/$1" ]; then printf '%s\n' "$FLEET_HOME/bin/$1"; return; fi
  if [ -x "$SELF_DIR/$1" ]; then printf '%s\n' "$SELF_DIR/$1"; return; fi
  printf '%s\n' "$1"
}
FC_BIN="$(resolve_bin fleet-config)"
fc() { "$FC_BIN" "$@"; }

TARGET_CWD="${1:-}"
CHAT_ID="${2:-}"
LOG_DIR="$FLEET_HOME/logs"
LOG="$LOG_DIR/usage.log"
mkdir -p "$LOG_DIR" 2>/dev/null || true

{
  echo ""
  echo "=== $(date '+%F %T') usage cwd=$TARGET_CWD chat=$CHAT_ID dryrun=${CC_USAGE_DRYRUN:-0} ==="

  if [ -z "$TARGET_CWD" ] || [ -z "$CHAT_ID" ]; then
    echo "ERROR missing args (need: workdir, chat_id)"
    exit 1
  fi

  # Gate: the calling workdir must belong to a known fleet bot.
  BOT_KEY="$(fc bot-by-workdir "$TARGET_CWD" key 2>/dev/null || true)"
  if [ -z "$BOT_KEY" ]; then
    echo "REFUSE unknown workdir (not in fleet.json): $TARGET_CWD"
    exit 2
  fi
  STATE_DIR="$(fc bot-by-workdir "$TARGET_CWD" state_dir 2>/dev/null || true)"

  # Build the bot list (name<TAB>project-dir per line) from fleet.json.
  FLEET_BOTS=""
  while IFS= read -r key; do
    [ -n "$key" ] || continue
    name="$(fc bot "$key" name 2>/dev/null || true)"
    [ -n "$name" ] || name="$key"
    proj="$(fc project-dir "$key" 2>/dev/null || true)"
    [ -n "$proj" ] || continue
    FLEET_BOTS="${FLEET_BOTS}${name}	${proj}
"
  done < <(fc bots 2>/dev/null)
  if [ -z "$FLEET_BOTS" ]; then
    echo "ERROR no bots resolved from fleet.json"
    exit 3
  fi

  # Fetch plan limits with the user's own Claude Code OAuth token (Keychain).
  # The token stays in this variable only - never logged, never echoed, never
  # written anywhere. Any failure -> empty JSON -> soft-degrade in the report.
  OAUTH_TOK=""
  if [ "${TELEBOTS_TEST:-0}" != 1 ] || [ -z "${CC_USAGE_LIMITS_FILE:-}" ]; then
    OAUTH_TOK=$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null | /usr/bin/python3 -c "import json,sys; print(json.load(sys.stdin).get('claudeAiOauth',{}).get('accessToken',''))" 2>/dev/null)
  fi
  LIMITS_JSON=""
  if [ -n "$OAUTH_TOK" ]; then
    LIMITS_JSON=$(curl -s -m 15 "https://api.anthropic.com/api/oauth/usage" \
      -H "Authorization: Bearer $OAUTH_TOK" \
      -H "anthropic-beta: oauth-2025-04-20" \
      -H "Content-Type: application/json" 2>/dev/null || true)
    echo "limits fetch: $([ -n "$LIMITS_JSON" ] && echo "got $(printf %s "$LIMITS_JSON" | wc -c | tr -d ' ') bytes" || echo "EMPTY")"
  else
    echo "limits fetch: no OAuth token available"
  fi
  if [ "${TELEBOTS_TEST:-0}" = 1 ] && [ -n "${CC_USAGE_LIMITS_FILE:-}" ]; then
    LIMITS_JSON=$(cat "$CC_USAGE_LIMITS_FILE" 2>/dev/null || true)
    echo "limits fixture: $([ -n "$LIMITS_JSON" ] && echo loaded || echo missing)"
  fi

  MSG=$(LIMITS_JSON="$LIMITS_JSON" FLEET_BOTS="$FLEET_BOTS" /usr/bin/python3 <<'PY'
import json, os, glob, time, math
from datetime import datetime, timedelta

BOTS = []
for line in os.environ["FLEET_BOTS"].splitlines():
    if "\t" in line:
        name, proj = line.split("\t", 1)
        BOTS.append((name, proj))

# "Today" (and every reset time below) in this machine's local timezone.
now = datetime.now().astimezone()
today = now.date()
week_cutoff_ts = time.time() - 7 * 86400

per_bot_today = {}
fleet = {"today_out": 0, "today_in": 0, "week_out": 0, "week_in": 0, "today_turns": 0, "week_turns": 0}
models_week = {}
subagent_files = 0
seen = set()

for bot, proj in BOTS:
    t_out = t_turns = 0
    files = glob.glob(os.path.join(proj, "*.jsonl"))
    subagents = glob.glob(os.path.join(proj, "*", "subagents", "*.jsonl"))
    for f in files + subagents:
        try:
            if os.path.getmtime(f) < week_cutoff_ts:
                continue
            if f in subagents:
                subagent_files += 1
            with open(f, "rb") as fh:
                for line_number, raw in enumerate(fh, 1):
                    if b'"usage"' not in raw or b'"assistant"' not in raw:
                        continue
                    try:
                        o = json.loads(raw)
                    except Exception:
                        continue
                    if o.get("type") != "assistant":
                        continue
                    m = o.get("message") or {}
                    u = m.get("usage") or {}
                    if "output_tokens" not in u:
                        continue
                    mid = m.get("id")
                    request_id = o.get("requestId")
                    identity = (mid, request_id) if mid and request_id else ("uuid", o.get("uuid") or (f, line_number))
                    if identity in seen:
                        continue
                    seen.add(identity)
                    ts = o.get("timestamp", "")
                    try:
                        dt = datetime.fromisoformat(ts.replace("Z", "+00:00")).astimezone()
                    except Exception:
                        continue
                    if dt.timestamp() < week_cutoff_ts:
                        continue
                    out = int(u.get("output_tokens", 0) or 0)
                    fresh = int(u.get("input_tokens", 0) or 0) + int(u.get("cache_creation_input_tokens", 0) or 0)
                    fleet["week_out"] += out
                    fleet["week_in"] += fresh
                    fleet["week_turns"] += 1
                    mdl = (m.get("model") or "?").replace("claude-", "")
                    models_week[mdl] = models_week.get(mdl, 0) + out
                    if dt.date() == today:
                        fleet["today_out"] += out
                        fleet["today_in"] += fresh
                        fleet["today_turns"] += 1
                        t_out += out
                        t_turns += 1
        except Exception:
            continue
    if t_out or t_turns:
        per_bot_today[bot] = (t_out, t_turns)

def k(n):
    if n >= 1_000_000: return f"{n/1_000_000:.1f}M"
    if n >= 1_000:     return f"{n/1_000:.0f}k"
    return str(n)

# -- Plan limits (same source as the terminal /usage screen) ------------------
# Meter style: orange = used, black = left, each limit in its own labeled
# block. Emoji squares are the only "color" Telegram text has.
def bar(pct, segs=20):
    filled = max(0, min(segs, math.floor(pct / 100 * segs + 0.5)))
    return "█" * filled + "░" * (segs - filled)

def fmt_reset(iso):
    try:
        dt = datetime.fromisoformat(iso.replace("Z", "+00:00")).astimezone()
        if dt.date() == today:
            day = "today"
        elif dt.date() == today + timedelta(days=1):
            day = "tomorrow"
        else:
            day = dt.strftime("%A")
        return f"{day} {dt.strftime('%-I:%M%p').lower()} {dt.strftime('%Z')}"
    except Exception:
        return "?"

limit_blocks = []
try:
    lj = json.loads(os.environ.get("LIMITS_JSON", "") or "{}")
    meta = {"session": ("⏳", "SESSION (5h)"), "weekly_all": ("🗓", "WEEK - ALL MODELS")}
    for lim in lj.get("limits", []):
        pct = lim.get("percent")
        if pct is None:
            continue
        kind = lim.get("kind", "")
        icon, label = meta.get(kind, (None, None))
        if label is None:
            scope = ((lim.get("scope") or {}).get("model") or {}).get("display_name")
            if not scope:
                continue
            icon, label = "✴️", f"WEEK - {scope.upper()}"
        reset = datetime.fromisoformat(lim.get("resets_at", "").replace("Z", "+00:00")).astimezone()
        remaining = max(0, (reset - now).total_seconds())
        period = 5 * 3600 if kind == "session" else 7 * 86400
        budget = max(0, min(100, (period - remaining) / period * 100))
        gap = abs(pct - budget)
        pace = (f"{gap:.0f}% over budget" if pct > budget else
                f"{gap:.0f}% under budget" if pct < budget else "right on budget")
        if kind == "session":
            detail = f"{bar(pct)} {pct:.0f}% used · {pace}"
        else:
            elapsed_days = max(0, min(7, (period - remaining) / 86400))
            today_index = min(6, int(elapsed_days))
            day_boxes = " ".join("█" * 3 if i < int(pct / 100 * 7) else "░" * 3 for i in range(7))
            detail = f"{day_boxes}\n{bar(pct)} {pct:.0f}% used · {pace} · {max(0, ((today_index + 1) / 7 * 100 - pct)):.0f}% left today"
        limit_blocks.append(f"{icon} {label}\n{detail}\n↳ resets {fmt_reset(lim.get('resets_at', ''))}")
except Exception:
    limit_blocks = []

lines = [f"📈 Usage - {now.strftime('%A, %B %-d')}", ""]
if limit_blocks:
    lines.append("YOUR PLAN LIMITS")
    lines.append("")
    lines.append("\n\n".join(limit_blocks))
else:
    lines.append("(Plan limits unavailable right now - couldn't reach Anthropic's usage endpoint. Burn numbers below are still live.)")
lines.append("")
lines.append("――――――――――――")
lines.append("")
lines.append(f"FLEET BURN TODAY: {k(fleet['today_out'])} tokens across {fleet['today_turns']} responses ({k(fleet['today_in'])} fresh in)")
if per_bot_today:
    for bot, (o, t) in sorted(per_bot_today.items(), key=lambda x: -x[1][0]):
        lines.append(f"  ▪️ {bot}: {k(o)} out / {t} responses")
lines.append("")
lines.append(f"LAST 7 DAYS: {k(fleet['week_out'])} tokens across {fleet['week_turns']} responses ({k(fleet['week_in'])} fresh in)")
top = [(m, v) for m, v in sorted(models_week.items(), key=lambda x: -x[1]) if v > 0 and not m.startswith("<")][:3]
if top:
    lines.append("  ▪️ by model: " + ", ".join(f"{m} {k(v)}" for m, v in top))
lines.append("")
source = "subagents included" if subagent_files else "no subagent transcripts found"
lines.append(f"(Limits come from your Claude plan. Burn is measured from the bots' session records; {source}.)")
print("\n".join(lines))
PY
)

  echo "--- report ---"
  echo "$MSG"
  echo "--------------"

  if [ "${CC_USAGE_DRYRUN:-0}" = "1" ]; then
    echo "=== dryrun done (not sent) ==="
    exit 0
  fi

  # Calling bot's token from its state-dir .env (read at runtime, never logged).
  TOKEN=""
  if [ -f "$STATE_DIR/.env" ]; then
    TOKEN="$(grep -E '^TELEGRAM_BOT_TOKEN=' "$STATE_DIR/.env" | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'" | tr -d '[:space:]')"
  fi
  if [ -z "$TOKEN" ]; then
    echo "ERROR no bot token for $STATE_DIR"
    exit 4
  fi
  printf 'url = "https://api.telegram.org/bot%s/sendMessage"\n' "$TOKEN" | curl --config - -s -m 10 -o /dev/null -X POST \
    --data-urlencode "chat_id=${CHAT_ID}" \
    --data-urlencode "text=${MSG}" \
    && echo "sent" || echo "send FAILED"

  echo "=== done ==="
} >> "$LOG" 2>&1
