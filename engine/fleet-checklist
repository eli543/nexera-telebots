def read_json(path, default=None):
    try:
        with open(path, encoding="utf-8") as stream:
            return json.load(stream)
    except (OSError, ValueError):
        return default


def read_json_output(output):
    try:
        return json.loads(output)
    except ValueError:
        return None


def run(command, timeout=15, input_text=None):
    return subprocess.run(command, input=input_text, text=True, capture_output=True,
                          check=False, timeout=timeout)


def token_from(state):
    try:
        for line in (state / ".env").read_text().splitlines():
            if line.startswith("TELEGRAM_BOT_TOKEN="):
                return line.split("=", 1)[1].strip().strip('"\'')
    except OSError:
        pass
    return ""


def api_base():
    override = os.environ.get("TELEBOTS_API_BASE", "")
    if os.environ.get("TELEBOTS_TEST") == "1" and re.fullmatch(
            r"http://(?:127\.0\.0\.1|localhost|\[::1\]):[0-9]{2,5}/?", override):
        return override.rstrip("/")
    return "https://api.telegram.org"


def telegram(token, method, data=None):
    payload = None if data is None else urlencode(data).encode()
    request = Request(f"{api_base()}/bot{token}/{method}", data=payload)
    with urlopen(request, timeout=10) as response:
        value = json.load(response)
    if value.get("ok") is not True:
        raise ValueError("Telegram API rejected the request")
    return value.get("result")


def event_lines(state):
    try:
        return (state / "logs" / "poller-events.log").read_text().splitlines()
    except OSError:
        return []


def lines_since(state, started):
    return log_lines_since(state / "logs" / "poller-events.log", started)


def log_lines_since(path, started):
    result = []
    try:
        source = path.read_text().splitlines()
    except OSError:
        return result
    for line in source:
        try:
            stamp = datetime.fromisoformat(line.split(" ", 1)[0]).timestamp()
        except (ValueError, IndexError):
            continue
        if stamp >= started:
            result.append(line)
    return result


def guardian_sent(lines):
    for line in lines:
        if not event_seen([line], "GUARDIAN", reason=8, ok="true"):
            continue
        fields = dict(part.split("=", 1) for part in line.split()[2:] if "=" in part)
        try:
            pct, threshold = float(fields["pct"]), float(fields["threshold"])
        except (KeyError, ValueError):
            continue
        if 0 < threshold <= pct <= 100:
            return True
    return False


def reply_guard_sent(state, started):
    turn, sent = state / "reply_guard_turn", state / "reply_guard_sent"
    try:
        return (sent.stat().st_mtime >= started and turn.read_text().strip() != ""
                and turn.read_text().strip() == sent.read_text().strip())
    except OSError:
        return False


def event_seen(lines, name, **fields):
    for line in lines:
        parts = line.split()
        if len(parts) < 2 or parts[1] != name:
            continue
        values = dict(part.split("=", 1) for part in parts[2:] if "=" in part)
        if all(values.get(key) == str(value) for key, value in fields.items()):
            return True
    return False


def log_has(path, pattern):
    try:
        return bool(re.search(pattern, path.read_text(), flags=re.IGNORECASE))
    except OSError:
        return False


def fresh_log_has(path, pattern, started):
    try:
        return path.stat().st_mtime >= started and log_has(path, pattern)
    except OSError:
        return False


def result(status, detail):
    return {"status": status, "detail": detail}


def voice_backend_available():
    if (ROOT / "voice/daemon.sock").is_socket():
        return True
    if shutil.which("mlx_whisper") or (Path.home() / ".local/bin/mlx_whisper").is_file():
        return True
    return importlib.util.find_spec("faster_whisper") is not None


def auto_row(code, bot, fleet, state, token):
    engine = ROOT / "bin"
    logs = state / "logs"
    if code == "A1":
        verifier = engine / "verify-overlay.sh"
        check = run([str(verifier), "--status"]) if verifier.is_file() else None
        value = check.stdout.strip() if check else "NOT_INSTALLED"
        cache = Path.home() / ".claude/plugins/cache/claude-plugins-official/telegram/0.0.7/server.ts"
        return result("Passed" if value == "OK" and cache.is_file() else "Failed", value)
    if code == "A2":
        required = (ROOT / "ux.json", engine / "fleet-fresh", engine / "fleet-doctor")
        installed = read_json(Path.home() / ".claude/plugins/installed_plugins.json", {}).get("plugins", {})
        enabled = read_json(Path.home() / ".claude/settings.json", {}).get("enabledPlugins", {})
        plugin_name = "telegram-fleet@nexera-telebots"
        plugin_ok = plugin_name in installed and enabled.get(plugin_name, True) is True
        good = all(path.is_file() for path in required) and all(os.access(path, os.X_OK) for path in required[1:])
        return result("Passed" if good and plugin_ok else "Failed", "plugin, ux.json and engines" if good and plugin_ok else "plugin or engine missing")
    if code == "A3":
        if not token:
            return result("Failed", "token missing")
        hashes = [hashlib.sha256(token_from(Path(item["state_dir"]).expanduser()).encode()).digest()
                  for item in fleet.get("bots", [])]
        if hashes.count(hashlib.sha256(token.encode()).digest()) > 1:
            return result("Failed", "duplicate token")
        try:
            me = telegram(token, "getMe")
            return result("Passed", "@" + me.get("username", "bot"))
        except Exception:
            return result("Failed", "getMe rejected the token or API was unreachable")
    if code == "A4":
        try:
            age = time.time() - float((state / "poller.heartbeat").read_text().strip())
        except (OSError, ValueError):
            return result("Failed", "no heartbeat")
        fleet_state = run([str(engine / "fleet-state"), "--json"]) if (engine / "fleet-state").is_file() else None
        rows = read_json_output(fleet_state.stdout) if fleet_state and fleet_state.returncode == 0 else []
        selected = next((row for row in rows if row.get("key") == bot["key"]), None) if isinstance(rows, list) else None
        if selected and selected.get("up") is True and 0 <= age < 60:
            return result("Passed", f"heartbeat {int(age)}s old; session and poller up")
        return result("Failed", "session/poller state or heartbeat missing")
    if code == "A5":
        try:
            info = telegram(token, "getWebhookInfo")
            allowed = info.get("allowed_updates", [])
            ok = all(name in allowed for name in ("message", "callback_query", "message_reaction"))
            return result("Passed" if ok else "Failed", ", ".join(allowed))
        except Exception:
            return result("Failed", "getWebhookInfo unavailable")
    if code == "A6":
        try:
            commands = telegram(token, "getMyCommands", {"scope": json.dumps({"type": "all_private_chats"})})
            names = [item.get("command") for item in commands]
            return result("Passed" if names == list(COMMANDS) else "Failed", ", ".join(names))
        except Exception:
            return result("Failed", "getMyCommands unavailable")
    if code == "A7":
        access = read_json(state / "access.json", {})
        ok = access.get("dmPolicy") == "allowlist" and bool(access.get("allowFrom")) and (state / ".enrolled").is_file()
        return result("Passed" if ok else "Failed", "allowlist and enrolled" if ok else "pair and lock this bot")
    if code == "A8":
        voice = fleet.get("options", {}).get("voice", "auto")
        if voice == "off":
            return result("Not configured", "voice disabled")
        if not (engine / "transcribe-voice").is_file() or not voice_backend_available():
            return result("Not configured", "no local voice backend installed")
        with tempfile.TemporaryDirectory(prefix="voice-check-", dir=ROOT) as temp:
            audio = str(Path(temp) / "sample.aiff")
            sample = run(["say", "-o", audio, "Check the voice note"], timeout=30)
            if sample.returncode:
                return result("Failed", "the Mac could not create a local voice sample")
            transcript = run([str(engine / "transcribe-voice"), audio], timeout=180)
            words = transcript.stdout.lower()
            ok = transcript.returncode == 0 and "voice" in words and "note" in words
            return result("Passed" if ok else "Failed", "local voice sample matched" if ok else "voice sample did not match")
    if code == "A9":
        plist = Path.home() / "Library/LaunchAgents/com.claude-fleet.watchdog.plist"
        if not plist.is_file():
            return result("Not configured", "optional watchdog is not installed")
        check = run(["launchctl", "list"])
        probe = run(["/bin/bash", str(engine / "watchdog.sh"), "--dry-run"]) if (engine / "watchdog.sh").is_file() else None
        ok = "com.claude-fleet.watchdog" in check.stdout and probe and probe.returncode == 0
        return result("Passed" if ok else "Needs your action", "loaded and dry run clean" if ok else "install or inspect the watchdog")
    if code == "A10":
        check = run(["claude", "--version"])
        version = re.search(r"\d+\.\d+\.\d+", check.stdout)
        inbound = read_json(Path.home() / ".claude/settings.json", {}).get("crossSessionInbound", "allow")
        stance = (ROOT / "permission-stance").read_text().strip() if (ROOT / "permission-stance").is_file() else "safe"
        good = version and tuple(map(int, version.group().split("."))) >= (2, 1, 224) and inbound not in ("refuse", "hold") and stance in ("safe", "scoped", "full")
        return result("Passed" if good else "Failed", f"Claude Code {version.group() if version else '?'}; inbound={inbound}; stance={stance}")
    if code == "A11":
        email_cfg = read_json(ROOT / "email.json", {})
        menu = Path.home() / "Applications/Telebots Bar.app"
        if not email_cfg.get("enabled") and not menu.exists():
            return result("Not configured", "email and menu bar are optional")
        details = []
        if email_cfg.get("enabled"):
            check = run([str(engine / "fleet-email"), "test"], input_text="{}")
            details.append("email ok" if check.returncode == 0 else "email test failed")
        if menu.exists():
            check = run(["pgrep", "-x", "Telebots Bar"])
            details.append("menu bar running" if check.returncode == 0 else "menu bar not running")
        return result("Passed" if all("failed" not in x and "not running" not in x for x in details) else "Failed", "; ".join(details))
    return result("Failed", "unknown row")


def phone_row(code, state, notes, fleet_size, email_enabled, crash_test, started=0):
    lines = lines_since(state, started) if started else event_lines(state)
    logs = state / "logs"
    evidence = lambda name, pattern: fresh_log_has(logs / name, pattern, started)
    if code == "P1":
        stream_file = state / "stream" / "state.json"
        stream = read_json(stream_file, {})
        try:
            stream_fresh = stream_file.stat().st_mtime >= started
        except OSError:
            stream_fresh = False
        ok = (event_seen(lines, "INBOUND", kind="text")
              and event_seen(log_lines_since(logs / "ack.log", started), "ACK", ok="true")
              and stream_fresh and stream.get("rich_box") is True
              and bool(stream.get("msgid")) and bool(stream.get("mission"))
              and reply_guard_sent(state, started))
    elif code == "P2": ok = event_seen(lines, "TAP", family="qr")
    elif code == "P3": ok = event_seen(lines, "REACTION") and notes.is_dir() and any(path.stat().st_mtime >= started for path in notes.glob("20??-??-??.md"))
    elif code == "P4": ok = event_seen(lines, "KEY")
    elif code == "P5": ok = all(event_seen(lines, "PICKER", kind=kind) and event_seen(lines, "CLOSE", kind=kind) for kind in ("model", "effort"))
    elif code == "P6": ok = evidence("sessions.log", r"count=[1-9].*labels=[1-9]") and event_seen(lines, "CLOSE", kind="resume")
    elif code == "P7": ok = event_seen(lines, "VOICE", status="ok") and evidence("voice-transcribe.log", r"status=ok")
    elif code == "P8": ok = evidence("update.log", r"update") and evidence("fresh.log", r"back-online ping sent")
    elif code == "P9": ok = event_seen(lines, "INTERCEPT", cmd="esc") and evidence("esc.log", r"key landed")
    elif code == "P10": ok = all(event_seen(lines, "INTERCEPT", cmd=cmd) and evidence(f"{cmd}.log", r".") for cmd in ("context", "usage"))
    elif code == "P11": ok = evidence("compact.log", r"exit (?:0|14)\b")
    elif code == "P12": ok = guardian_sent(log_lines_since(logs / "guardian.log", started)) and event_seen(lines, "TAP", family="qr")
    elif code == "P13":
        if fleet_size < 2: return result("Not configured", "needs two bots")
        ok = event_seen(lines, "HANDOFF-PICKER") and event_seen(lines, "CLOSE", kind="handoff")
    elif code == "P14":
        if not email_enabled: return result("Not configured", "email is optional")
        ok = event_seen(lines, "INTERCEPT", cmd="inbox") and event_seen(lines, "EMAIL-PREVIEW") and (ROOT / "inbox-snoozed.json").is_file() and (ROOT / "inbox-snoozed.json").stat().st_mtime >= started
    elif code == "P15":
        if not crash_test: return result("Not configured", "run with --crash-test after approval")
        ok = fresh_log_has(ROOT / "logs/watchdog.log", r"RESTART", started) and evidence("fresh.log", r"back-online ping sent")
    elif code == "P16": ok = event_seen(lines, "INTERCEPT", cmd="fresh") and evidence("fresh.log", r"back-online ping sent")
    else: ok = False
    return result("Passed" if ok else "Needs your action", "recorded evidence found" if ok else "complete this phone step and rerun")


