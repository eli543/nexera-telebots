def read_json(path, default=None):
    try:
        with open(path, encoding="utf-8") as stream:
            return json.load(stream)
    except (OSError, ValueError):
        return default


def read_json_output(output):
    try:
        return json.loads(output)
    except ValueError:
        return None


def run(command, timeout=15, input_text=None):
    return subprocess.run(command, input=input_text, text=True, capture_output=True,
                          check=False, timeout=timeout)


def token_from(state):
    try:
        for line in (state / ".env").read_text().splitlines():
            if line.startswith("TELEGRAM_BOT_TOKEN="):
                return line.split("=", 1)[1].strip().strip('"\'')
    except OSError:
        pass
    return ""


def api_base():
    override = os.environ.get("TELEBOTS_API_BASE", "")
    if os.environ.get("TELEBOTS_TEST") == "1" and re.fullmatch(
            r"http://(?:127\.0\.0\.1|localhost|\[::1\]):[0-9]{2,5}/?", override):
        return override.rstrip("/")
    return "https://api.telegram.org"


def telegram(token, method, data=None):
    payload = None if data is None else urlencode(data).encode()
    request = Request(f"{api_base()}/bot{token}/{method}", data=payload)
    with urlopen(request, timeout=10) as response:
        value = json.load(response)
    if value.get("ok") is not True:
        raise ValueError("Telegram API rejected the request")
    return value.get("result")


def event_lines(state):
    try:
        return (state / "logs" / "poller-events.log").read_text().splitlines()
    except OSError:
        return []


def lines_since(state, started):
    return log_lines_since(state / "logs" / "poller-events.log", started)


def log_lines_since(path, started):
    result = []
    try:
        source = path.read_text().splitlines()
    except OSError:
        return result
    for line in source:
        try:
            prefix = line.split(" ", 1)[0]
            stamp = datetime.fromisoformat(prefix if "T" in prefix else line[:19]).timestamp()
        except (ValueError, IndexError):
            continue
        if stamp >= int(started):
            result.append(line)
    return result


def guardian_sent(lines):
    for line in lines:
        if not event_seen([line], "GUARDIAN", reason=8, ok="true"):
            continue
        fields = dict(part.split("=", 1) for part in line.split()[2:] if "=" in part)
        try:
            pct, threshold = float(fields["pct"]), float(fields["threshold"])
        except (KeyError, ValueError):
            continue
        if 0 < threshold <= pct <= 100:
            return True
    return False


def reply_guard_sent(state, started):
    turn, sent = state / "reply_guard_turn", state / "reply_guard_sent"
    try:
        return (sent.stat().st_mtime >= started and turn.read_text().strip() != ""
                and turn.read_text().strip() == sent.read_text().strip())
    except OSError:
        return False


def event_seen(lines, name, **fields):
    for line in lines:
        parts = line.split()
        if len(parts) < 2 or parts[1] != name:
            continue
        values = dict(part.split("=", 1) for part in parts[2:] if "=" in part)
        if all(values.get(key) == str(value) for key, value in fields.items()):
            return True
    return False


def matching_events(lines, name):
    for line in lines:
        parts = line.split()
        if len(parts) >= 2 and parts[1] == name:
            yield dict(part.split("=", 1) for part in parts[2:] if "=" in part)


def reply_recipients_match(read_receipt, consent, own_address):
    """Check the latest message's reply recipients, excluding this account."""
    if not isinstance(read_receipt, dict) or not isinstance(consent, dict):
        return False
    outgoing = consent.get("email")
    if not isinstance(outgoing, dict) or consent.get("phase") != "consumed":
        return False
    def addresses(value):
        if not isinstance(value, str):
            return []
        return [address.casefold() for _, address in getaddresses([value]) if address]
    own = set(addresses(own_address))
    direct = addresses(read_receipt.get("reply_to") or read_receipt.get("from"))
    if not direct or any(address in own for address in direct):
        return False
    copied = addresses(read_receipt.get("to")) + addresses(read_receipt.get("cc"))
    expected_to = set(direct)
    expected_cc = {address for address in copied if address not in own | expected_to}
    actual_to, actual_cc, actual_bcc = (outgoing.get(key) for key in ("to", "cc", "bcc"))
    if not all(isinstance(value, list) and all(isinstance(item, str) for item in value)
               for value in (actual_to, actual_cc, actual_bcc)):
        return False
    return (set(address.casefold() for address in actual_to) == expected_to
            and set(address.casefold() for address in actual_cc) == expected_cc
            and not actual_bcc)


def log_has(path, pattern):
    try:
        return bool(re.search(pattern, path.read_text(), flags=re.IGNORECASE))
    except OSError:
        return False


def fresh_log_has(path, pattern, started):
    try:
        return path.stat().st_mtime >= started and log_has(path, pattern)
    except OSError:
        return False


def bot_record(state):
    fleet = read_json(ROOT / "fleet.json", {})
    return next((bot for bot in fleet.get("bots", [])
                 if Path(bot.get("state_dir", "")).expanduser() == state), None)


def engine_run(state, name, started):
    """Last run for this bot after the step began, excluding earlier successes."""
    bot = bot_record(state)
    if not bot:
        return ""
    path = ROOT / "logs" / (name + ".log")
    try:
        lines = path.read_text().splitlines()
    except OSError:
        return ""
    selected = []
    active = False
    header = re.compile(r"^=== (\d{4}-\d\d-\d\d \d\d:\d\d:\d\d) (?:esc|compact|restart) pid=.* cwd=(.*?) (?:dryrun=|focus_len=|===)")
    for line in lines:
        match = header.match(line)
        if match:
            try:
                timestamp = datetime.fromisoformat(match.group(1)).timestamp()
            except ValueError:
                timestamp = 0
            active = match.group(2) == bot.get("workdir") and timestamp >= int(started)
            if active:
                selected = []
        if active:
            selected.append(line)
    return "\n".join(selected)


def restart_receipt(state, started, resume=None, quiet=None):
    bot = bot_record(state)
    if not bot:
        return False
    lines = log_lines_since(ROOT / "watchdog-state" / (bot["key"] + ".manual_restart_log"), started)
    for line in lines:
        fields = dict(part.split("=", 1) for part in line.split() if "=" in part)
        if fields.get("cwd") != bot.get("workdir") or fields.get("exit") != "0":
            continue
        if resume is not None and fields.get("resume") != resume:
            continue
        if quiet is not None and fields.get("quiet") != quiet:
            continue
        return True
    return False


def session_id(state):
    try:
        value = (state / "session.id").read_text().strip()
    except OSError:
        return ""
    return value if re.fullmatch(r"[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}", value) else ""


def baseline_for(state):
    try:
        model = (state / "model-state").read_text()
    except OSError:
        model = ""
    return {"session_id": session_id(state), "model_state": model}


def result(status, detail):
    return {"status": status, "detail": detail}


def voice_backend_available():
    if (ROOT / "voice/daemon.sock").is_socket():
        return True
    if shutil.which("mlx_whisper") or (Path.home() / ".local/bin/mlx_whisper").is_file():
        return True
    return importlib.util.find_spec("faster_whisper") is not None


def auto_row(code, bot, fleet, state, token):
    engine = ROOT / "bin"
    logs = state / "logs"
    if code == "A1":
        verifier = engine / "verify-overlay.sh"
        check = run([str(verifier), "--status"]) if verifier.is_file() else None
        value = check.stdout.strip() if check else "NOT_INSTALLED"
        cache = Path.home() / ".claude/plugins/cache/claude-plugins-official/telegram/0.0.7/server.ts"
        return result("Passed" if value == "OK" and cache.is_file() else "Failed", value)
    if code == "A2":
        required = (ROOT / "ux.json", engine / "fleet-fresh", engine / "fleet-doctor")
        installed = read_json(Path.home() / ".claude/plugins/installed_plugins.json", {}).get("plugins", {})
        enabled = read_json(Path.home() / ".claude/settings.json", {}).get("enabledPlugins", {})
        plugin_name = "telegram-fleet@nexera-telebots"
        plugin_ok = plugin_name in installed and enabled.get(plugin_name, True) is True
        good = all(path.is_file() for path in required) and all(os.access(path, os.X_OK) for path in required[1:])
        return result("Passed" if good and plugin_ok else "Failed", "plugin, ux.json and engines" if good and plugin_ok else "plugin or engine missing")
    if code == "A3":
        if not token:
            return result("Failed", "token missing")
        hashes = [hashlib.sha256(token_from(Path(item["state_dir"]).expanduser()).encode()).digest()
                  for item in fleet.get("bots", [])]
        if hashes.count(hashlib.sha256(token.encode()).digest()) > 1:
            return result("Failed", "duplicate token")
        try:
            me = telegram(token, "getMe")
            return result("Passed", "@" + me.get("username", "bot"))
        except Exception:
            return result("Failed", "getMe rejected the token or API was unreachable")
    if code == "A4":
        try:
            age = time.time() - float((state / "poller.heartbeat").read_text().strip())
        except (OSError, ValueError):
            return result("Failed", "no heartbeat")
        fleet_state = run([str(engine / "fleet-state"), "--json"]) if (engine / "fleet-state").is_file() else None
        rows = read_json_output(fleet_state.stdout) if fleet_state and fleet_state.returncode == 0 else []
        selected = next((row for row in rows if row.get("key") == bot["key"]), None) if isinstance(rows, list) else None
        if selected and selected.get("up") is True and 0 <= age < 60:
            return result("Passed", f"heartbeat {int(age)}s old; session and poller up")
        return result("Failed", "session/poller state or heartbeat missing")
    if code == "A5":
        try:
            info = telegram(token, "getWebhookInfo")
            allowed = info.get("allowed_updates", [])
            ok = all(name in allowed for name in ("message", "callback_query", "message_reaction"))
            return result("Passed" if ok else "Failed", ", ".join(allowed))
        except Exception:
            return result("Failed", "getWebhookInfo unavailable")
    if code == "A6":
        try:
            commands = telegram(token, "getMyCommands", {"scope": json.dumps({"type": "all_private_chats"})})
            names = [item.get("command") for item in commands]
            return result("Passed" if names == list(COMMANDS) else "Failed", ", ".join(names))
        except Exception:
            return result("Failed", "getMyCommands unavailable")
    if code == "A7":
        access = read_json(state / "access.json", {})
        ok = access.get("dmPolicy") == "allowlist" and bool(access.get("allowFrom")) and (state / ".enrolled").is_file()
        return result("Passed" if ok else "Failed", "allowlist and enrolled" if ok else "pair and lock this bot")
    if code == "A8":
        voice = fleet.get("options", {}).get("voice", "auto")
        if voice == "off":
            return result("Not configured", "voice disabled")
        if not (engine / "transcribe-voice").is_file() or not voice_backend_available():
            return result("Not configured", "no local voice backend installed")
        with tempfile.TemporaryDirectory(prefix="voice-check-", dir=ROOT) as temp:
            audio = str(Path(temp) / "sample.aiff")
            sample = run(["say", "-o", audio, "Check the voice note"], timeout=30)
            if sample.returncode:
                return result("Failed", "the Mac could not create a local voice sample")
            transcript = run([str(engine / "transcribe-voice"), audio], timeout=180)
            words = transcript.stdout.lower()
            ok = transcript.returncode == 0 and "voice" in words and "note" in words
            return result("Passed" if ok else "Failed", "local voice sample matched" if ok else "voice sample did not match")
    if code == "A9":
        plist = Path.home() / "Library/LaunchAgents/com.claude-fleet.watchdog.plist"
        if not plist.is_file():
            return result("Not configured", "optional watchdog is not installed")
        check = run(["launchctl", "list"])
        probe = run(["/bin/bash", str(engine / "watchdog.sh"), "--dry-run"]) if (engine / "watchdog.sh").is_file() else None
        ok = "com.claude-fleet.watchdog" in check.stdout and probe and probe.returncode == 0
        return result("Passed" if ok else "Needs your action", "loaded and dry run clean" if ok else "install or inspect the watchdog")
    if code == "A10":
        check = run(["claude", "--version"])
        version = re.search(r"\d+\.\d+\.\d+", check.stdout)
        inbound = read_json(Path.home() / ".claude/settings.json", {}).get("crossSessionInbound", "allow")
        stance = (ROOT / "permission-stance").read_text().strip() if (ROOT / "permission-stance").is_file() else "safe"
        good = version and tuple(map(int, version.group().split("."))) >= (2, 1, 224) and inbound not in ("refuse", "hold") and stance in ("safe", "scoped", "full")
        return result("Passed" if good else "Failed", f"Claude Code {version.group() if version else '?'}; inbound={inbound}; stance={stance}")
    if code == "A11":
        email_cfg = read_json(ROOT / "email.json", {})
        menu = Path.home() / "Applications/Telebots Bar.app"
        if not email_cfg.get("enabled") and not menu.exists():
            return result("Not configured", "email and menu bar are optional")
        details = []
        if email_cfg.get("enabled"):
            check = run([str(engine / "fleet-email"), "test"], input_text="{}")
            details.append("email ok" if check.returncode == 0 else "email test failed")
        if menu.exists():
            check = run(["pgrep", "-x", "Telebots Bar"])
            details.append("menu bar running" if check.returncode == 0 else "menu bar not running")
        return result("Passed" if all("failed" not in x and "not running" not in x for x in details) else "Failed", "; ".join(details))
    return result("Failed", "unknown row")


def phone_row(code, state, notes, fleet_size, email_enabled, crash_test, started=0, baseline=None):
    lines = lines_since(state, started) if started else event_lines(state)
    logs = state / "logs"
    evidence = lambda name, pattern: fresh_log_has(logs / name, pattern, started)
    fleet_evidence = lambda name, pattern: bool(re.search(pattern, "\n".join(log_lines_since(ROOT / "logs" / name, started)), re.I))
    fresh = engine_run(state, "fresh", started)
    bot = bot_record(state)
    if code == "P1":
        stream_file = state / "stream" / "state.json"
        stream = read_json(stream_file, {})
        try:
            stream_fresh = stream_file.stat().st_mtime >= started
        except OSError:
            stream_fresh = False
        ok = (event_seen(lines, "INBOUND", kind="text")
              and event_seen(log_lines_since(logs / "ack.log", started), "ACK", ok="true")
              and stream_fresh and stream.get("rich_box") is True
              and bool(stream.get("msgid")) and bool(stream.get("mission"))
              and reply_guard_sent(state, started))
    elif code == "P2": ok = event_seen(lines, "TAP", family="qr")
    elif code == "P3": ok = event_seen(lines, "REACTION") and notes.is_dir() and any(path.stat().st_mtime >= started for path in notes.glob("20??-??-??.md"))
    elif code == "P4": ok = event_seen(lines, "KEY")
    elif code == "P5": ok = all(event_seen(lines, "PICKER", kind=kind) and event_seen(lines, "CLOSE", kind=kind) for kind in ("model", "effort"))
    elif code == "P6": ok = fleet_evidence("sessions.log", r"RENDER count=[1-9].*labels=[1-9]") and event_seen(lines, "CLOSE", kind="resume")
    elif code == "P7": ok = event_seen(lines, "VOICE", status="ok") and evidence("voice-transcribe.log", r"status=ok")
    elif code == "P8":
        update = "\n".join(log_lines_since(logs / "update.log", started))
        ok = (bool(re.search(r"fleet-fresh exit=0", update))
              and bool(re.search(r"back-online ping sent", update))
              and "restart proof accepted" in fresh and restart_receipt(state, started, quiet="quiet"))
    elif code == "P9":
        esc = engine_run(state, "esc", started)
        ok = bool(re.search(r"=== done \(sent Esc to /dev/ttys[0-9]+\) ===", esc))
    elif code == "P10":
        ok = all(event_seen(lines, "INTERCEPT", cmd=cmd) and fleet_evidence(f"{cmd}.log", r".")
                 for cmd in ("context", "usage"))
    elif code == "P11":
        compact = engine_run(state, "compact", started)
        ok = bool(re.search(r"=== done \((?:path [AB].*delivered .* /compact.*|Claude Code answered: Not enough messages to compact)\) ===", compact))
    elif code == "P12": ok = guardian_sent(log_lines_since(logs / "guardian.log", started)) and event_seen(lines, "TAP", family="qr")
    elif code == "P13":
        if fleet_size < 2: return result("Not configured", "needs two bots")
        source = bot_record(state)
        fleet = read_json(ROOT / "fleet.json", {})
        for sent in matching_events(lines, "HANDOFF-SENT"):
            note_id, target, delivery = sent.get("id", ""), sent.get("target", ""), sent.get("delivery", "")
            if (not source or sent.get("source") != source.get("key") or
                    not re.fullmatch(r"[a-f0-9]{24}", note_id) or not re.fullmatch(r"[a-f0-9]{24}", delivery) or
                    not event_seen(lines, "HANDOFF-ISSUED", id=note_id, source=source["key"], target=target, delivery=delivery)):
                continue
            record_path = ROOT / "handoffs" / "deliveries" / (delivery + ".json")
            try:
                record = read_json(record_path, {})
                fresh = (record_path.stat().st_mode & 0o777 == 0o600 and
                         started * 1000 <= record.get("issued_at", 0) <= time.time() * 1000 and
                         record.get("phase") == "received" and record.get("delivery_id") == delivery and
                         record.get("note_id") == note_id and record.get("source") == source["key"] and
                         record.get("target") == target)
            except (OSError, TypeError, ValueError):
                fresh = False
            if not fresh:
                continue
            peer = next((item for item in fleet.get("bots", []) if item.get("key") == target and target != source.get("key")), None)
            if not peer:
                continue
            target_state = Path(peer.get("state_dir", "")).expanduser()
            received = log_lines_since(target_state / "logs/poller-events.log", started)
            if event_seen(received, "HANDOFF-RECEIVED", id=note_id, source=source["key"], target=target, delivery=delivery):
                return result("Passed", "agent-attested delivery ID matched in both pollers; check the acknowledgement in the second chat")
        return result("Needs your action", "complete the handoff; both pollers need matching receipts for a fresh one-use delivery ID")
    elif code == "P14":
        if not email_enabled: return result("Not configured", "email is optional")
        for reply in matching_events(lines, "EMAIL-REPLY"):
            consent_id, read_id = reply.get("id", ""), reply.get("read", "")
            if reply.get("status") != "sent" or not re.fullmatch(r"[a-f0-9]{24}", consent_id) or not re.fullmatch(r"[a-f0-9]{24}", read_id):
                continue
            receipt = state / "mail-reads" / (read_id + ".json")
            try:
                read_record = read_json(receipt, {})
                consent = read_json(state / "consents.json", {}).get(consent_id, {})
                own = read_json(ROOT / "email.json", {}).get("from", "")
                full_read = (receipt.stat().st_mtime >= started and receipt.stat().st_mode & 0o777 == 0o600
                             and read_record.get("full") is True and reply_recipients_match(read_record, consent, own))
            except OSError:
                full_read = False
            if full_read and event_seen(lines, "EMAIL-CONFIRM", id=consent_id) and event_seen(lines, "EMAIL-SEND", id=consent_id, status="sent"):
                return result("Passed", "full inbox read linked to two-tap confirmation and SMTP acceptance; check the reply in the mail account")
        return result("Needs your action", "complete a full inbox reply; no matching read, confirmation and SMTP receipt is recorded")
    elif code == "P15":
        if not crash_test:
            return result("Needs your action", "Recovery untested; run the optional exact-PID test with a person at the Mac. A chat active within 30 minutes resumes; an older chat restarts blank. Reboot still untested")
        key = bot["key"] if bot else ""
        watchdog = "\n".join(log_lines_since(ROOT / "logs/watchdog.log", started))
        ok = (bool(re.search(r"\bRESTART " + re.escape(key) + r" via fleet-fresh", watchdog))
              and bool(re.search(r"result: (?:resumed|fresh) \(engine exit 0\)", watchdog))
              and restart_receipt(state, started, quiet="quiet")
              and "restart proof accepted" in fresh and "back-online ping suppressed" in fresh)
        return result("Passed" if ok else "Needs your action",
                      "Quiet engine recovery recorded; a chat active within 30 minutes resumes, otherwise it restarts blank. Verify the phone round trip" if ok
                      else "Quiet watchdog recovery not proven. A chat active within 30 minutes resumes, otherwise it restarts blank; reboot is untested")
    elif code == "P16":
        previous = (baseline or {}).get("session_id", "")
        ok = (bool(previous) and session_id(state) not in ("", previous)
              and event_seen(lines, "INTERCEPT", cmd="fresh")
              and restart_receipt(state, started, resume="fresh-reset")
              and "restart proof accepted" in fresh and "back-online ping sent" in fresh
              and not (state / "model-state").exists())
    elif code == "P17":
        previous = (baseline or {}).get("session_id", "")
        try:
            model_now = (state / "model-state").read_text()
        except OSError:
            model_now = ""
        model_log = "\n".join(log_lines_since(ROOT / "logs/model.log", started))
        ok = (bool(previous) and session_id(state) == previous and model_now
              and model_now != (baseline or {}).get("model_state", "")
              and bool(re.search(r"RESTART .* resume=" + re.escape(previous) + r"\b", model_log))
              and restart_receipt(state, started, resume=previous)
              and "restart proof accepted" in fresh)
    elif code == "P18":
        previous, reopened = (baseline or {}).get("session_id", ""), session_id(state)
        ok = (bool(previous) and bool(reopened) and reopened != previous
              and event_seen(lines, "PICK", kind="resume")
              and restart_receipt(state, started, resume=reopened, quiet="quiet")
              and "restart proof accepted" in fresh)
    elif code == "P19":
        return result("Needs your action", "Reboot restore untested: snapshot, reboot, log in, restore and confirm the same chat answers on the phone")
    elif code == "P20":
        if not (Path.home() / "Applications/Telebots Bar.app").exists():
            return result("Not configured", "phone rescue needs optional Telebots Bar and Tailscale")
        return result("Needs your action", "Phone rescue untested: with all bots down, reconnect through the Tailscale page and verify a bot reply")
    else: ok = False
    detail = ("backend evidence recorded; confirm phone delivery directly" if ok
              else "complete this phone step and rerun; phone delivery is not proven by an engine log alone")
    return result("Passed" if ok else "Needs your action", detail)


PHONE_STEPS = {
    "P1": 'Send "hi" and wait for the acknowledgement, live box and reply.',
    "P2": 'Tap the "Checklist OK" bubble below the new checklist message.',
    "P3": "React with a heart to a bot message; check your notes folder.",
    "P4": "Send /key and read the legend.",
    "P5": "Open /model and tap Close, then open /effort and tap Close.",
    "P6": "Open /resume, check that every row describes a chat, then tap Close.",
    "P7": "Send a short voice note and wait for its transcript.",
    "P8": "Send /update and wait for Back and ready with Continue.",
    "P9": "Ask for a slow count, then send /esc while the bot is busy.",
    "P10": "Send /context and /usage; wait for both reports.",
    "P11": "Send /compact and wait for completion or the short-chat response.",
    "P12": "Send one message to trigger the context nudge, then tap Keep going.",
    "P13": "With two bots, complete a handoff and confirm the second bot received the note.",
    "P14": "Open /inbox, read a complete message, reply with the original recipients and confirm the exact preview twice.",
    "P15": "Optional exact-PID crash test with a person at the Mac. Recovery is quiet; check the bot by sending a new message.",
    "P16": "Last step: send /fresh and verify a new blank chat and Back and ready.",
    "P17": "Switch to another available model and effort, then confirm this conversation id is preserved.",
    "P18": "Open /resume and select a different saved chat; confirm that chat opens.",
    "P19": "Snapshot, reboot, log in and restore; confirm the same chat answers on the phone.",
    "P20": "If Telebots Bar and Tailscale are set up, reconnect from the phone when every bot is down.",
}


def chat_id(state):
    access = read_json(state / "access.json", {})
    users = access.get("allowFrom", [])
    return str(users[0]) if users else ""


def notify_phone(token, state, text, bubble=False):
    recipient = chat_id(state)
    if not token or not recipient:
        return False
    data = {"chat_id": recipient, "text": text}
    if bubble:
        data["reply_markup"] = json.dumps({"inline_keyboard": [[
            {"text": "Checklist OK", "callback_data": "qr:0:0"}]]})
    try:
        telegram(token, "sendMessage", data)
        return True
    except Exception:
        return False


def save_results(path, key, values):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temp = tempfile.mkstemp(prefix=".checklist-", dir=path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump({"bot": key, "checked_at": time.time(), "rows": values}, stream, indent=2)
            stream.write("\n")
        os.replace(temp, path)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def exact_session_pid(state):
    listing = run(["ps", "-axo", "pid=,command="])
    if listing.returncode:
        return None
    for line in listing.stdout.splitlines():
        match = re.match(r"\s*([0-9]+)\s+(.+)", line)
        if not match or "--channels plugin:telegram@claude-plugins-official" not in match.group(2):
            continue
        pid = int(match.group(1))
        env = run(["ps", "eww", "-p", str(pid)])
        if env.returncode == 0 and re.search(
                r"(?:^|\s)TELEGRAM_STATE_DIR=" + re.escape(str(state)) + r"(?=\s|$)", env.stdout):
            return pid
    return None


def crash_exact_session(state, key, non_interactive):
    if non_interactive or not sys.stdin.isatty():
        return False, "a person must confirm this exact-PID test at the Mac"
    pid = exact_session_pid(state)
    if pid is None:
        return False, "no matching session PID was found"
    answer = input(f"Type CRASH {key} to stop session PID {pid} and test the watchdog: ")
    if answer != f"CRASH {key}":
        return False, "crash test was not confirmed"
    if exact_session_pid(state) != pid:
        return False, "session identity changed; nothing was signaled"
    os.kill(pid, signal.SIGTERM)
    return True, f"signaled exact session PID {pid}"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("key", nargs="?")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--non-interactive", action="store_true")
    parser.add_argument("--wait", type=int, default=120)
    parser.add_argument("--crash-test", action="store_true")
    parser.add_argument("--blank-fresh", action="store_true", help="include the optional last-step blank restart")
    parser.add_argument("--consent", action="store_true")
    parser.add_argument("--recorded-evidence", action="store_true",
                        help="sandbox only: evaluate existing logs without phone requests")
    args = parser.parse_args()
    if args.recorded_evidence and args.crash_test:
        parser.error("recorded evidence cannot initiate a crash test")
    if args.dry_run:
        for code, label, source in ROWS:
            print(f"{code:3} {label:32} source: {source}")
        return 0
    if args.consent:
        print("macOS may ask for Terminal Automation and Accessibility. Respond at this Mac.")
        automation = run(["osascript", "-e", 'tell application "Terminal" to get name'])
        accessibility = run(["osascript", "-e", 'tell application "System Events" to get UI elements enabled'])
        print(f"Terminal Automation: {'ready' if automation.returncode == 0 else 'needs your action'}")
        print(f"Accessibility: {'ready' if accessibility.returncode == 0 and accessibility.stdout.strip() == 'true' else 'needs your action'}")
        return 0 if automation.returncode == 0 and accessibility.returncode == 0 and accessibility.stdout.strip() == "true" else 1
    if args.recorded_evidence:
        sandbox = Path(os.environ.get("TELEBOTS_SANDBOX_ROOT", "/"))
        if os.environ.get("TELEBOTS_TEST") != "1" or sandbox.resolve() not in ROOT.resolve().parents:
            parser.error("recorded evidence is limited to a test sandbox")
    fleet = read_json(ROOT / "fleet.json", {})
    bot = next((item for item in fleet.get("bots", []) if item.get("key") == args.key), None)
    if bot is None:
        parser.error("choose a configured bot key")
    state = Path(bot["state_dir"]).expanduser()
    if args.recorded_evidence and sandbox.resolve() not in state.resolve().parents:
        parser.error("recorded state is outside the test sandbox")
    token = token_from(state)
    notes = Path(fleet.get("options", {}).get("notes_dir", "~/Telebots Notes")).expanduser()
    if args.crash_test:
        print("Self-heal needs a separate, explicit exact-PID test. No process was signaled by this checklist.")
    values = {}
    for code, label, source in ROWS:
        if code.startswith("A"):
            try: values[code] = auto_row(code, bot, fleet, state, token)
            except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
                values[code] = result("Failed", str(exc).splitlines()[0][:120])
        else:
            if code == "P13" and len(fleet.get("bots", [])) < 2:
                values[code] = result("Not configured", "needs two bots")
            elif code == "P7" and (fleet.get("options", {}).get("voice") == "off" or not voice_backend_available()):
                values[code] = result("Not configured", "local voice backend is not configured")
            elif code == "P14" and not read_json(ROOT / "email.json", {}).get("enabled", False):
                values[code] = result("Not configured", "email is optional")
            elif code == "P15" and not args.crash_test:
                values[code] = result("Needs your action", "Watchdog recovery untested. A chat active within 30 minutes resumes; an older chat restarts blank. Use --crash-test only with a person at the Mac")
            elif code == "P16" and not args.blank_fresh:
                values[code] = result("Needs your action", "Blank /fresh untested; rerun with --blank-fresh after saving current work")
            elif code in ("P19", "P20"):
                values[code] = phone_row(code, state, notes, len(fleet.get("bots", [])),
                                         read_json(ROOT / "email.json", {}).get("enabled", False),
                                         args.crash_test)
            else:
                instruction = PHONE_STEPS[code]
                print(f"{code}: {instruction}")
                started = 0 if args.recorded_evidence else time.time()
                baseline = baseline_for(state)
                threshold = state / "guardian-thresholds"
                original = threshold.read_bytes() if code == "P12" and threshold.exists() else None
                try:
                    if code == "P12" and not args.recorded_evidence:
                        threshold.write_text("1\n")
                    sent = True if args.recorded_evidence else notify_phone(token, state, instruction, bubble=(code == "P2"))
                    if not sent:
                        print("Phone instruction could not be delivered; it is printed above.")
                    if code == "P15":
                        approved, detail = crash_exact_session(state, args.key, args.non_interactive)
                        if not approved:
                            values[code] = result("Needs your action", detail)
                    if code != "P15" or approved:
                        deadline = started + max(0, args.wait)
                        while True:
                            values[code] = phone_row(code, state, notes, len(fleet.get("bots", [])),
                                                     read_json(ROOT / "email.json", {}).get("enabled", False),
                                                     args.crash_test, started, baseline)
                            if values[code]["status"] == "Passed" or time.time() >= deadline:
                                break
                            time.sleep(2)
                finally:
                    if code == "P12":
                        if original is None:
                            threshold.unlink(missing_ok=True)
                        else:
                            threshold.write_bytes(original)
        print(f"{code:3} {values[code]['status']:18} {label}: {values[code]['detail']}")
    output = ROOT / f"checklist-{args.key}.json"
    save_results(output, args.key, values)
    summary = ", ".join(f"{code} {value['status']}" for code, value in values.items())
    if not args.recorded_evidence:
        notify_phone(token, state, "Checklist: " + summary)
    return 0 if all(v["status"] in ("Passed", "Not configured") for v in values.values()) else 1


if __name__ == "__main__":
    sys.exit(main())
