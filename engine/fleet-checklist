def chat_id(state):
    access = read_json(state / "access.json", {})
    users = access.get("allowFrom", [])
    return str(users[0]) if users else ""


def notify_phone(token, state, text, bubble=False):
    recipient = chat_id(state)
    if not token or not recipient:
        return False
    data = {"chat_id": recipient, "text": text}
    if bubble:
        data["reply_markup"] = json.dumps({"inline_keyboard": [[
            {"text": "Checklist OK", "callback_data": "qr:0:0"}]]})
    try:
        telegram(token, "sendMessage", data)
        return True
    except Exception:
        return False


def save_results(path, key, values):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temp = tempfile.mkstemp(prefix=".checklist-", dir=path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump({"bot": key, "checked_at": time.time(), "rows": values}, stream, indent=2)
            stream.write("\n")
        os.replace(temp, path)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def exact_session_pid(state):
    listing = run(["ps", "-axo", "pid=,command="])
    if listing.returncode:
        return None
    for line in listing.stdout.splitlines():
        match = re.match(r"\s*([0-9]+)\s+(.+)", line)
        if not match or "--channels plugin:telegram@claude-plugins-official" not in match.group(2):
            continue
        pid = int(match.group(1))
        env = run(["ps", "eww", "-p", str(pid)])
        if env.returncode == 0 and re.search(
                r"(?:^|\s)TELEGRAM_STATE_DIR=" + re.escape(str(state)) + r"(?=\s|$)", env.stdout):
            return pid
    return None


def crash_exact_session(state, key, non_interactive):
    if non_interactive or not sys.stdin.isatty():
        return False, "a person must confirm this exact-PID test at the Mac"
    pid = exact_session_pid(state)
    if pid is None:
        return False, "no matching session PID was found"
    answer = input(f"Type CRASH {key} to stop session PID {pid} and test the watchdog: ")
    if answer != f"CRASH {key}":
        return False, "crash test was not confirmed"
    if exact_session_pid(state) != pid:
        return False, "session identity changed; nothing was signaled"
    os.kill(pid, signal.SIGTERM)
    return True, f"signaled exact session PID {pid}"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("key", nargs="?")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--non-interactive", action="store_true")
    parser.add_argument("--wait", type=int, default=120)
    parser.add_argument("--crash-test", action="store_true")
    parser.add_argument("--blank-fresh", action="store_true", help="include the optional last-step blank restart")
    parser.add_argument("--consent", action="store_true")
    parser.add_argument("--recorded-evidence", action="store_true",
                        help="sandbox only: evaluate existing logs without phone requests")
    args = parser.parse_args()
    if args.dry_run:
        for code, label, source in ROWS:
            print(f"{code:3} {label:32} source: {source}")
        return 0
    if args.consent:
        print("macOS may ask for Terminal Automation and Accessibility. Respond at this Mac.")
        automation = run(["osascript", "-e", 'tell application "Terminal" to get name'])
        accessibility = run(["osascript", "-e", 'tell application "System Events" to get UI elements enabled'])
        print(f"Terminal Automation: {'ready' if automation.returncode == 0 else 'needs your action'}")
        print(f"Accessibility: {'ready' if accessibility.returncode == 0 and accessibility.stdout.strip() == 'true' else 'needs your action'}")
        return 0 if automation.returncode == 0 and accessibility.returncode == 0 and accessibility.stdout.strip() == "true" else 1
    if args.recorded_evidence:
        sandbox = Path(os.environ.get("TELEBOTS_SANDBOX_ROOT", "/"))
        if os.environ.get("TELEBOTS_TEST") != "1" or sandbox.resolve() not in ROOT.resolve().parents:
            parser.error("recorded evidence is limited to a test sandbox")
    fleet = read_json(ROOT / "fleet.json", {})
    bot = next((item for item in fleet.get("bots", []) if item.get("key") == args.key), None)
    if bot is None:
        parser.error("choose a configured bot key")
    state = Path(bot["state_dir"]).expanduser()
    if args.recorded_evidence and sandbox.resolve() not in state.resolve().parents:
        parser.error("recorded state is outside the test sandbox")
    token = token_from(state)
    notes = Path(fleet.get("options", {}).get("notes_dir", "~/Telebots Notes")).expanduser()
    if args.crash_test:
        print("Self-heal needs a separate, explicit exact-PID test. No process was signaled by this checklist.")
    values = {}
    for code, label, source in ROWS:
        if code.startswith("A"):
            try: values[code] = auto_row(code, bot, fleet, state, token)
            except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
                values[code] = result("Failed", str(exc).splitlines()[0][:120])
        else:
            if code == "P13" and len(fleet.get("bots", [])) < 2:
                values[code] = result("Not configured", "needs two bots")
            elif code == "P7" and (fleet.get("options", {}).get("voice") == "off" or not voice_backend_available()):
                values[code] = result("Not configured", "local voice backend is not configured")
            elif code == "P14" and not read_json(ROOT / "email.json", {}).get("enabled", False):
                values[code] = result("Not configured", "email is optional")
            elif code == "P15" and not args.crash_test:
                values[code] = result("Not configured", "optional exact-PID test")
            elif code == "P16" and not args.blank_fresh:
                values[code] = result("Not configured", "optional blank restart; rerun with --blank-fresh")
            else:
                instruction = PHONE_STEPS[code]
                print(f"{code}: {instruction}")
                started = 0 if args.recorded_evidence else time.time()
                threshold = state / "guardian-thresholds"
                original = threshold.read_bytes() if code == "P12" and threshold.exists() else None
                try:
                    if code == "P12" and not args.recorded_evidence:
                        threshold.write_text("1\n")
                    sent = True if args.recorded_evidence else notify_phone(token, state, instruction, bubble=(code == "P2"))
                    if not sent:
                        print("Phone instruction could not be delivered; it is printed above.")
                    if code == "P15":
                        approved, detail = crash_exact_session(state, args.key, args.non_interactive)
                        if not approved:
                            values[code] = result("Needs your action", detail)
                    if code != "P15" or approved:
                        deadline = started + max(0, args.wait)
                        while True:
                            values[code] = phone_row(code, state, notes, len(fleet.get("bots", [])),
                                                     read_json(ROOT / "email.json", {}).get("enabled", False),
                                                     args.crash_test, started)
                            if values[code]["status"] == "Passed" or time.time() >= deadline:
                                break
                            time.sleep(2)
                finally:
                    if code == "P12":
                        if original is None:
                            threshold.unlink(missing_ok=True)
                        else:
                            threshold.write_bytes(original)
        print(f"{code:3} {values[code]['status']:18} {label}: {values[code]['detail']}")
    output = ROOT / f"checklist-{args.key}.json"
    save_results(output, args.key, values)
    summary = ", ".join(f"{code} {value['status']}" for code, value in values.items())
    if not args.recorded_evidence:
        notify_phone(token, state, "Checklist: " + summary)
    return 0 if all(v["status"] in ("Passed", "Not configured") for v in values.values()) else 1


if __name__ == "__main__":
    sys.exit(main())
