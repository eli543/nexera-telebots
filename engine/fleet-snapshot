#!/bin/bash
# fleet-snapshot - PRE-RESTART snapshot for a planned macOS restart / update.
#
# Records each bot's current Claude session id so it can be RESUMED (not started
# fresh) after login, and parks the watchdog so it cannot spawn blank sessions
# during the boot window. Pairs with fleet-restore (the post-login half).
#
# Usage:
#   fleet-snapshot                   capture + park the watchdog (real run)
#   fleet-snapshot --dry-run         capture to a .dryrun file + print only; park nothing
#   fleet-snapshot --keep-watchdog   capture, park NOTHING: auto-recovery stays on
#                                    (a save point from the menu bar app or the phone)
#   --dry-run and --keep-watchdog combine, in either order. Any other argument is
#   refused (exit 2) before anything is read or written.
#
# Read-only except for (a) the snapshot file, (b) touching the watchdog's own
# per-bot kill switches (never with --keep-watchdog) and (c) holding the fleet
# transaction lock (real run only). It never kills or launches anything. Config
# driven; no hardcoded bot list. macOS (ps eww / stat -f).
#
# Exit codes: 0 saved; 1 failed or saved INCOMPLETE (the message says which);
# 2 unknown argument, nothing touched; 7 skipped because another fleet-snapshot or
# a fleet-restore holds the fleet transaction lock, nothing touched.

# Rollback removes only switches whose inode still matches this transaction's
# private hard link. A concurrent manual replacement is preserved.
set -uo pipefail

# Why: the watchdog only auto-resumes a session touched in the last ~30 min;
# anything idle longer comes back blank. For a planned restart we want EVERY bot
# resumed, so we record the precise session ids to disk up front (disk survives a
# reboot; processes do not).
#
# --keep-watchdog: a snapshot taken from the app or the phone is a save point, not
# a reboot, so it must not switch auto-recovery off. With the flag the snapshot
# captures exactly what it captures without it, but creates NO <key>.disabled
# switch; the PARKED column reads "kept" for every bot it left under the watchdog
# and the closing line says auto-recovery was left on. Switches an earlier,
# still-unconsumed snapshot set (its we_parked=1 rows) stay this snapshot's own
# exactly as without the flag, so fleet-restore still removes them; a switch set
# by hand still reads already_disabled=1.
#
# Fixes, each reproduced on a scratch fleet first:
#  - Session id: when <state_dir>/session.id names a session whose transcript
#    exists, that RUNNING session is recorded, not whichever transcript is newest.
#    A session.id with no transcript yet is a session that has not spoken: it is
#    recorded empty (restore starts it fresh). With no session.id the newest
#    transcript is still used, and the table says it is unverified.
#  - Snapshot again: switches set by an earlier snapshot that no restore has
#    consumed yet stay the snapshot's own (we_parked=1) instead of being recorded
#    as manual disables, which left every bot down after the restore.
#  - Write failures: the snapshot goes to a temp file and is moved into place only
#    when every line was written; otherwise it exits 1 and removes the switches
#    this run set. A switch that cannot be set also exits 1.
#  - One transaction at a time: a real run holds the fleet transaction lock (a
#    directory under /tmp whose file "pid" names the holder; fleet-restore holds
#    the same lock) from start to finish, so a snapshot and a restore can never
#    interleave. It is taken over only from a run whose pid is dead.
#  - Generation: the header line ends in generation=<epoch>-<pid>-<random>;
#    fleet-restore reports the generation it processed and archives only that one.
#  - Interruption: every row is decided first; then the switches are created (each
#    only if it does not exist yet, so a switch someone else set is never claimed)
#    and the file is committed in one rename right after. An EXIT, INT or TERM trap
#    removes the temp file and exactly the switches this run created whenever the
#    file was not committed, and releases the lock.

case "${1:-}" in -h|--help) sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;; esac

# Keep custom fleet paths stable across Terminal's new shell and hook children.
FLEET_HOME="$(python3 -c 'import os,sys; print(os.path.abspath(os.path.expanduser(sys.argv[1])))' "${FLEET_HOME:-$HOME/.claude/telegram-fleet}")" || exit 2
export FLEET_HOME
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
resolve_bin() {
  if [ -x "$FLEET_HOME/bin/$1" ]; then printf '%s\n' "$FLEET_HOME/bin/$1"; return; fi
  if [ -x "$SELF_DIR/$1" ]; then printf '%s\n' "$SELF_DIR/$1"; return; fi
  printf '%s\n' "$1"
}
FC_BIN="$(resolve_bin fleet-config)"
fc() { "$FC_BIN" "$@"; }
# Reject duplicate keys and shared/invalid paths before any lookup can choose a bot.
fc validate >/dev/null || { echo "Invalid fleet configuration; nothing acted on." >&2; exit 2; }
FLEET_CONFIG="$(fc path)" || exit 2
export FLEET_CONFIG

DRY_RUN=0
KEEP_WATCHDOG=0
for arg in "$@"; do
  case "$arg" in
    --dry-run)       DRY_RUN=1 ;;
    --keep-watchdog) KEEP_WATCHDOG=1 ;;
    *)
      echo "fleet-snapshot: unknown argument '$(printf '%s' "$arg" | LC_ALL=C tr -d '\000-\037\177' | cut -c1-80)' (expected --dry-run and/or --keep-watchdog). Nothing was saved and nothing was parked."
      exit 2 ;;
  esac
done

WD_STATE="$FLEET_HOME/watchdog-state"
RESTART_STATE="$FLEET_HOME/restart-state"
SNAP="$RESTART_STATE/snapshot.tsv"
[ $DRY_RUN -eq 1 ] && SNAP="$RESTART_STATE/snapshot.dryrun.tsv"
# Locks live under /tmp (cleared at boot), named for this fleet so parallel fleets
# or a test run never collide. fleet-fresh and fleet-restore use the same names.
LOCK_ROOT=/tmp
if [[ ${TELEBOTS_TEST:-} == 1 ]]; then
  case "${TMPDIR:-}" in
    "${TELEBOTS_SANDBOX_ROOT:?}"/*) LOCK_ROOT="${TMPDIR%/}" ;;
    *) echo "The test lock directory is outside the sandbox." >&2; exit 8 ;;
  esac
fi
LOCK_BASE="$LOCK_ROOT/nexera-telebots-$(printf '%s' "$FLEET_HOME" | cksum | awk '{print $1}')"
FLEET_LOCK="$LOCK_BASE-fleet-lock"   # the snapshot/restore transaction lock
LOCK_STALE=180   # must match fleet-fresh: a lock that records NO pid and is older than this belonged to a crashed run
if ! mkdir -p "$RESTART_STATE" "$WD_STATE"; then
  echo "Snapshot FAILED: cannot create $RESTART_STATE or $WD_STATE. Nothing was saved and nothing was parked."
  exit 1
fi

# ---- restart and fleet locks: one protocol, three copies ---------------------
# fleet-fresh, fleet-restore and fleet-snapshot all carry this block word for
# word; change one and change the others. A bot's restart lock is the directory
# <LOCK_BASE>-fresh-lock-<key>; the fleet transaction lock, held from start to
# finish by a real fleet-snapshot and by a real fleet-restore, is the directory
# <LOCK_BASE>-fleet-lock. In either one the file "pid" names the run that holds
# it. LOCK_STALE is set by each script.
#  - Taking it: mkdir the directory, then record this run's pid. The pid is
#    written to a private file and hard-linked into place, so a pid file is
#    always complete and never overwrites another run's; it is then read back.
#  - A lock whose recorded pid is alive is never taken over, however old: taking
#    over by age alone once let a long restart lose its lock and a third run in.
#  - A lock is taken over only when its recorded pid is dead, or when it records
#    no pid and is older than LOCK_STALE. The takeover makes its own mkdir
#    first (<lock>/takeover), so only one run at a time can take a lock over;
#    under that claim it re-checks that the lock still records what was judged
#    stale, then replaces the pid file in one atomic rename. No run ever moves
#    or deletes a pid file it did not write. A claim left by a run that died
#    mid-takeover (a takeover takes milliseconds) is cleared after 60 seconds.
#  - Releasing it: only while its pid file still names this run.
# Durable per-generation hard links are both the ownership proof and undo journal.
# Write journal before publishing switches. Replay only under the fleet lock.
snapshot_generation() {
  head -1 "$1" 2>/dev/null | sed -n 's/.* generation=\([0-9A-Za-z_-]\{1,64\}\)$/\1/p'
}
snapshot_owns_switch() {
  local generation="$1" key="$2" ref
  [[ "$generation" =~ ^[0-9A-Za-z_-]{1,64}$ && "$key" =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]] || return 1
  ref="$RESTART_STATE/.snapshot-markers-$generation/$key"
  [[ -f "$ref" && ! -L "$ref" && ! -L "$WD_STATE/$key.disabled" && "$WD_STATE/$key.disabled" -ef "$ref" ]]
}
recover_snapshot_journals() {
  local current dir generation ref key
  current=$(snapshot_generation "$RESTART_STATE/snapshot.tsv")
  for dir in "$RESTART_STATE"/.snapshot-markers-*; do
    [[ -d "$dir" && ! -L "$dir" ]] || continue
    generation=${dir##*/.snapshot-markers-}
    [[ "$generation" =~ ^[0-9A-Za-z_-]{1,64}$ ]] || { echo "Invalid snapshot journal: $dir" >&2; return 1; }
    [[ "$generation" == "$current" ]] && continue
    for ref in "$dir"/*; do
      [[ -f "$ref" && ! -L "$ref" ]] || continue
      key=${ref##*/}
      [[ "$key" == journal ]] && continue
      [[ "$key" =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]] || return 1
      if snapshot_owns_switch "$generation" "$key" && ! snapshot_owns_switch "$current" "$key"; then
        rm -f "$WD_STATE/$key.disabled" || return 1
        echo "Recovered interrupted snapshot $generation: removed its $key watchdog switch"
      fi
      rm -f "$ref" || return 1
    done
    rm -f "$dir/journal" || return 1
    rmdir "$dir" || return 1
  done
}

# PID/start ownership is changed only under a stable, kernel-held flock gate.
# The gate lives beside the directory and is never unlinked. Crashes release it.
LOCK_NOTE=""
lock_pid_in() {
  local p
  p=$(head -1 "$1" 2>/dev/null | tr -d '[:space:]')
  [[ "$p" =~ ^[1-9][0-9]*$ ]] || p=""
  printf '%s' "$p"
}
lock_start() { LC_ALL=C TZ=UTC ps -p "$1" -o lstart= 2>/dev/null | awk '{$1=$1; print}'; }
LOCK_SELF_START=$(lock_start "$$")
if [[ "${CC_FLEET_MANAGED_GROUP:-}" == 1 ]]; then
  CC_FLEET_ENGINE_PGID=$(ps -p "$$" -o pgid= | tr -d '[:space:]')
  [[ "$CC_FLEET_ENGINE_PGID" =~ ^[1-9][0-9]*$ ]] || exit 8
  CC_FLEET_GROUP_START=${CC_FLEET_GROUP_START:-$(lock_start "$CC_FLEET_ENGINE_PGID")}
  [[ -n "$CC_FLEET_GROUP_START" ]] || exit 8
  export CC_FLEET_ENGINE_PGID CC_FLEET_GROUP_START
fi
lock_op() {
  python3 - "$1" "$2" "$$" "$LOCK_SELF_START" "$LOCK_STALE" "${CC_FLEET_ENGINE_PGID:-}" "${CC_FLEET_GROUP_START:-}" <<'LOCKPY'
import fcntl, os, shutil, subprocess, sys, time
from pathlib import Path
op, raw, pid, started, stale, group, group_start = sys.argv[1:]
dir = Path(raw)
file = dir / 'pid'
def start(p):
    try:
        r = subprocess.run(['/bin/ps', '-p', str(p), '-o', 'lstart='], capture_output=True, text=True,
                           env=dict(os.environ, TZ='UTC', LC_ALL='C'), timeout=3)
        return ' '.join(r.stdout.split()) if r.returncode == 0 else ''
    except (OSError, subprocess.SubprocessError):
        return None

def exists(p):
    try: os.kill(p, 0); return True
    except ProcessLookupError: return False
    except PermissionError: return True

def read():
    try: return file.read_text().splitlines()
    except FileNotFoundError: return []

def live(record):
    if record and record[0].isdigit() and int(record[0]) > 0 and exists(int(record[0])):
        now = start(record[0])
        if len(record) < 2 or not record[1] or not now or now == record[1]: return True
    if len(record) >= 4 and record[2].isdigit() and int(record[2]) > 1:
        # A reused group leader PID does not inherit its predecessor's lease.
        now = start(record[2])
        if now and now != record[3]: return False
        if exists(-int(record[2])): return True
    return False

try:
    if op == 'live': sys.exit(0 if live(read()) else 1)
    fd = os.open(raw + '.gate', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    if dir.is_symlink(): raise RuntimeError('lock directory is a symlink')
    record = read()
    if op == 'release':
        if record[:2] != [pid, started]: sys.exit(1)
        # The app supervises the whole group, including children after shell exit.
        # Preserve the lease until a later caller proves the group is gone.
        if not group: shutil.rmtree(dir)
    else:
        if not started: raise RuntimeError('cannot read this process start time')
        if live(record): raise RuntimeError('owner PID/start or its engine process group is live')
        if dir.exists() and not record and time.time() - dir.stat().st_mtime < int(stale):
            raise RuntimeError('owner identity has not been published yet')
        dir.mkdir(mode=0o700, exist_ok=True)
        tmp = dir / ('pid.new.' + pid)
        with open(tmp, 'w') as f:
            f.write('\n'.join([pid, started, group, group_start]) + '\n')
            f.flush(); os.fsync(f.fileno())
        os.replace(tmp, file)
        print('PID/start identity admitted under the kernel gate')
except (OSError, RuntimeError) as error:
    print(str(error)); sys.exit(1)
LOCKPY
}
lock_owner_live() { lock_op live "${1%/pid}"; }
lock_take() { LOCK_NOTE=$(lock_op take "$1"); }
lock_release() { lock_op release "$1"; }

# ---- one transaction: lock, generation, interruption cleanup ----------------
GEN="$(date +%s)-$$-$(printf '%04x' "$RANDOM")"
TMP="$SNAP.tmp.$$"
MARKER_DIR="$RESTART_STATE/.snapshot-markers-$GEN"
COMMITTED=0      # 1 once the file is renamed into place: from then on nothing is undone
LOCK_HELD=0
created=()       # switches THIS run created (removed again if the snapshot is not committed)

# Did the rename land? The header of the file on disk names this run's generation.
snapshot_landed() {
  [ -f "$SNAP" ] && head -1 "$SNAP" 2>/dev/null | grep -q " generation=$GEN\$"
}

remove_created_switches() {
  local k ref
  undone=0
  for k in ${created[@]+"${created[@]}"}; do
    ref="$MARKER_DIR/$k"
    if [[ -f "$ref" && "$WD_STATE/$k.disabled" -ef "$ref" ]]; then
      rm -f "$WD_STATE/$k.disabled" && undone=$((undone+1))
    fi
  done
}

snapshot_cleanup() {
  local k
  [[ $COMMITTED -eq 0 ]] && snapshot_landed && COMMITTED=1
  if [[ $COMMITTED -eq 0 ]]; then
    rm -f "$TMP" 2>/dev/null
    remove_created_switches
  fi
  if [[ $LOCK_HELD -eq 1 ]]; then recover_snapshot_journals || true; fi
  created=()
  if [[ $LOCK_HELD -eq 1 ]]; then
    lock_release "$FLEET_LOCK"
    LOCK_HELD=0
  fi
}

snapshot_interrupted() {   # snapshot_interrupted <exit code>
  trap - INT TERM
  snapshot_cleanup
  echo
  if [ $COMMITTED -eq 1 ]; then
    echo "Snapshot interrupted after it was saved: $SNAP is complete (generation $GEN)."
  else
    echo "Snapshot INTERRUPTED: nothing was saved, and every watchdog switch this run had set was removed again. Do not restart yet."
  fi
  exit "$1"
}

trap snapshot_cleanup EXIT
trap 'snapshot_interrupted 130' INT
trap 'snapshot_interrupted 143' TERM

if [ $DRY_RUN -eq 0 ]; then
  if ! lock_take "$FLEET_LOCK"; then
    echo "Snapshot NOT taken: another fleet-snapshot or a fleet-restore is running ($LOCK_NOTE). Nothing was saved and nothing was parked. Do not restart yet; run it again when that one finishes."
    exit 7
  fi
  LOCK_HELD=1
  recover_snapshot_journals || { echo "Snapshot recovery failed; nothing new parked"; exit 1; }
fi

# pid of the live session whose TELEGRAM_STATE_DIR matches $1 (env match, exactly
# like the watchdog, so one bot's pids are never confused with another's).
session_pid_for() {
  local want="$1" pid s
  # ps -axo + grep, deliberately not pgrep (macOS pgrep omits the caller's ancestor).
  # shellcheck disable=SC2009
  for pid in $(ps -axo pid=,command= | grep 'channels plugin:telegram' | grep -v grep | awk '{print $1}'); do
    [ -z "$pid" ] && continue
    s=$(ps eww -p "$pid" 2>/dev/null | python3 -c 'import re,sys; m=re.search(r"(?:^| )TELEGRAM_STATE_DIR=(.*?)(?= [A-Za-z_][A-Za-z0-9_]*=|$)", sys.stdin.read().rstrip("\n")); print(m.group(1) if m else "")')
    if [ "$s" = "$want" ]; then echo "$pid"; return; fi
  done
}

UUID_RE='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'

# The session to resume for one bot (see the note above). Sets sid, smtime and
# sid_note.
resolve_session() {   # resolve_session <state dir> <project dir>
  local sdir="$1" proj="$2" cand="" f b
  sid=""; smtime=0; sid_note=""
  [ -f "$sdir/session.id" ] && cand=$(head -1 "$sdir/session.id" 2>/dev/null | tr -d '\r\n')
  if [[ "$cand" =~ $UUID_RE ]]; then
    if [ -f "$proj/$cand.jsonl" ]; then
      sid="$cand"; smtime=$(stat -f %m "$proj/$cand.jsonl" 2>/dev/null || echo 0); sid_note="session.id"
    else
      sid_note="its session ${cand:0:8} has not spoken yet, so it restores fresh"
    fi
    return 0
  fi
  # transcript files are named by uuid (.jsonl) - no spaces; -t needs ls.
  # shellcheck disable=SC2012
  while IFS= read -r f; do
    b=$(basename "$f" .jsonl)
    [[ "$b" =~ $UUID_RE ]] || continue
    sid="$b"; smtime=$(stat -f %m "$f" 2>/dev/null || echo 0)
    sid_note="newest transcript, no session.id to verify it"
    return 0
  done < <(ls -t "$proj"/*.jsonl 2>/dev/null)
}

# Switches an earlier, still-unconsumed snapshot set (its we_parked=1 rows). They
# stay the snapshot's own on a repeat snapshot. Empty fields are preserved.
CARRIED=" "
PREVIOUS_GEN=$(snapshot_generation "$RESTART_STATE/snapshot.tsv")
if [ -f "$RESTART_STATE/snapshot.tsv" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in \#*|"") continue ;; esac
    IFS=$'\037' read -r k _ _ _ _ _ ad wp _ <<< "${line//$'\t'/$'\037'}"
    [[ "$ad" == "0" && "$wp" == "1" ]] && snapshot_owns_switch "$PREVIOUS_GEN" "$k" && CARRIED="$CARRIED$k "
  done < "$RESTART_STATE/snapshot.tsv"
fi

now=$(date +%s)
carried=""; park_failed=""

# ---- 1. decide every row, changing nothing ----------------------------------
r_key=(); r_cwd=(); r_sdir=(); r_proj=(); r_sid=(); r_run=(); r_ad=(); r_wp=(); r_mt=(); r_age=(); r_park=()
for key in $(fc bots); do
  sdir=$(fc bot "$key" state_dir)
  proj=$(fc project-dir "$key")
  cwd=$(fc bot "$key" workdir)

  resolve_session "$sdir" "$proj"
  if [ -n "$sid" ]; then
    age_str="${sid} ($(( now - smtime ))s ago, ${sid_note})"
  else
    age_str="(no session${sid_note:+: $sid_note})"
  fi

  pid=$(session_pid_for "$sdir")
  was_running=0; [ -n "$pid" ] && was_running=1

  # Park every bot that isn't already manually disabled so the watchdog can't
  # race the restore and start a blank session during boot. A switch the
  # unconsumed earlier snapshot set is the snapshot's own, not a manual disable.
  # With --keep-watchdog nothing new is parked: auto-recovery stays on.
  already_disabled=0; we_parked=0; park_new=0
  if [ -f "$WD_STATE/$key.disabled" ]; then
    case "$CARRIED" in
      *" $key "*) we_parked=1; carried="$carried $key" ;;
      *)          already_disabled=1 ;;
    esac
  elif [ $KEEP_WATCHDOG -eq 1 ]; then
    :   # left under the watchdog
  elif [ $DRY_RUN -eq 0 ]; then
    park_new=1   # parked in step 2, right before the commit
  else
    we_parked=1   # would park
  fi

  r_key+=("$key"); r_cwd+=("$cwd"); r_sdir+=("$sdir"); r_proj+=("$proj"); r_sid+=("$sid")
  r_run+=("$was_running"); r_ad+=("$already_disabled"); r_wp+=("$we_parked"); r_mt+=("$smtime")
  r_age+=("$age_str"); r_park+=("$park_new")
done

# The journal lands before any .disabled link. Carry only verified old inodes.
if [[ $DRY_RUN -eq 0 ]]; then
  mkdir -m 700 "$MARKER_DIR" || exit 1
  printf 'generation=%s\n%s\n' "$GEN" "${r_key[*]}" > "$MARKER_DIR/journal" || exit 1
  python3 - "$MARKER_DIR/journal" <<'JOURNAL'
import os, sys
with open(sys.argv[1], 'rb') as f: os.fsync(f.fileno())
JOURNAL
  [[ $? -eq 0 ]] || exit 1
  for key in $carried; do
    ln "$RESTART_STATE/.snapshot-markers-$PREVIOUS_GEN/$key" "$MARKER_DIR/$key" || exit 1
  done
fi

# ---- 2. park, then commit at once -------------------------------------------
# A switch is created only if it does not exist yet, so one that appeared since
# step 1 (someone else's) is never recorded as this run's and never removed by it.
# Each switch is hard-linked to a private inode before publication. Cleanup only
# removes that same inode, so interruption cannot delete a concurrent manual switch.
for i in "${!r_key[@]}"; do
  [ "${r_park[$i]}" = "1" ] || continue
  key="${r_key[$i]}"
  created+=("$key")
  if park_err=$(: > "$MARKER_DIR/$key" && python3 -c 'import os,sys; os.link(sys.argv[1], sys.argv[2])' "$MARKER_DIR/$key" "$WD_STATE/$key.disabled" 2>&1); then
    r_wp[i]=1
  else
    # Keep the private reference for cleanup even when publication failed.
    if [ -f "$WD_STATE/$key.disabled" ]; then
      r_ad[i]=1   # set by someone else since step 1: not this snapshot's
    else
      echo "${park_err:-cannot create $WD_STATE/$key.disabled}" >&2
      park_failed="$park_failed $key"
    fi
  fi
done

for i in "${!r_key[@]}"; do
  key="${r_key[$i]}"
  if [[ $DRY_RUN -eq 0 && "${r_wp[$i]}" == 1 ]] && ! snapshot_owns_switch "$GEN" "$key"; then
    r_wp[i]=0
    [[ -e "$WD_STATE/$key.disabled" ]] && r_ad[i]=1
  fi
done
write_ok=1
{
  echo "# nexera-telebots snapshot  $(date '+%F %T')  dry_run=$DRY_RUN  generation=$GEN"
  printf '# %s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' key cwd state_dir proj_dir session_id was_running already_disabled we_parked session_mtime_epoch
} > "$TMP" || write_ok=0
for i in "${!r_key[@]}"; do
  [ $write_ok -eq 1 ] || break
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "${r_key[$i]}" "${r_cwd[$i]}" "${r_sdir[$i]}" "${r_proj[$i]}" "${r_sid[$i]}" "${r_run[$i]}" "${r_ad[$i]}" "${r_wp[$i]}" "${r_mt[$i]}" >> "$TMP" || write_ok=0
done
# Only a completely written snapshot replaces the file, in one rename.
if [ $write_ok -eq 1 ]; then
  if mv -f "$TMP" "$SNAP"; then COMMITTED=1; else write_ok=0; fi
fi

printf '%-12s %-8s %-9s %-7s %s\n' "BOT" "RUNNING" "DISABLED" "PARKED" "SESSION (transcript age)"
for i in "${!r_key[@]}"; do
  parked_col=no
  if [ "${r_wp[$i]}" = "1" ]; then
    parked_col=yes
  elif [ $KEEP_WATCHDOG -eq 1 ] && [ "${r_ad[$i]}" = "0" ]; then
    parked_col=kept
  fi
  printf '%-12s %-8s %-9s %-7s %s\n' "${r_key[$i]}" \
    "$([ "${r_run[$i]}" = "1" ] && echo yes || echo no)" \
    "$([ "${r_ad[$i]}" = "1" ] && echo yes || echo no)" \
    "$parked_col" \
    "${r_age[$i]}"
done

# Otherwise the switches this run set are removed again, so a failed snapshot
# never leaves the watchdog parked with nothing to restore.
if [ $write_ok -eq 0 ]; then
  rm -f "$TMP" 2>/dev/null
  remove_created_switches
  echo
  echo "Snapshot FAILED: could not write $SNAP (see the error above). Nothing was saved, and the $undone watchdog switch(es) this run had just set were removed again. Do not restart yet."
  exit 1
fi

echo
echo "Snapshot written: $SNAP"
if [ -n "$carried" ] && [ $DRY_RUN -eq 1 ]; then
  echo "An earlier snapshot is still unconsumed: a real run keeps its watchdog switches for$carried as the snapshot's own."
elif [ -n "$carried" ]; then
  echo "Replaced an unconsumed earlier snapshot. Its watchdog switches for$carried stay the snapshot's own, so fleet-restore still re-enables the watchdog for them."
fi
if [ $DRY_RUN -eq 1 ]; then
  if [ $KEEP_WATCHDOG -eq 1 ]; then
    echo "DRY RUN: nothing changed except this .dryrun file. A real --keep-watchdog run would preserve auto-recovery settings and park no bot."
  else
    echo "DRY RUN: watchdog NOT parked. Nothing changed except this .dryrun file."
  fi
  exit 0
fi
if [ $KEEP_WATCHDOG -eq 1 ]; then
  echo "To bring the bots back into these sessions later, run:  fleet-restore"
  if [ -n "$carried" ]; then
    echo "Auto-recovery settings preserved: this snapshot parked no bot (${carried# } stay parked from the earlier snapshot until fleet-restore)."
  else
    echo "Auto-recovery settings preserved: this snapshot parked no bot, bots already off or paused stay that way."
  fi
  exit 0
fi
echo "Watchdog parked for the bots marked PARKED=yes - it will not start them during boot."
if [ -n "$park_failed" ]; then
  echo "Snapshot saved but INCOMPLETE: the watchdog could not be parked for$park_failed (see the error above). Fix that and run fleet-snapshot again before restarting."
  exit 1
fi
echo "You're clear to restart. After you log back in, run:  fleet-restore"
