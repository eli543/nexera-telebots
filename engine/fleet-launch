#!/bin/bash
# fleet-launch - start (or resume) one fleet bot's Claude session with its
# Telegram env wired up. This is the canonical launcher: fleet-fresh, the
# watchdog, and fleet-restore all reach a bot through here, so launch behavior
# lives in exactly one place.
#
# Args:
#   $1  bot key OR workdir (either is accepted; resolved via fleet-config)
#   $2  resume id (optional):
#         (empty)      fresh session; preserves per-bot model-state
#         fresh-reset  fresh session on the default model (explicit /fresh reset)
#         continue     resume the most recent conversation in this workdir
#         fresh-keep   empty session but KEEP the model-state /model wrote
#         <uuid>       resume that specific session (context preserving)
#       Anything else is refused (exit 2) before anything is written or launched.
#
# What it does: exports TELEGRAM_STATE_DIR + TELEGRAM_BOT_TOKEN (from the bot's
# state-dir .env) + CLAUDE_CODE_NO_FLICKER=1, applies the sticky per-bot model /
# effort if set (absent = your Claude Code default, no flags forced), applies the
# fleet permission stance, optionally asks the window-grid extra to tile, then
# exec's claude with the official telegram channel plugin.
#
# Env: FLEET_HOME (default ~/.claude/telegram-fleet); CC_LAUNCH_DRYRUN=1 prints
# the planned command and exits without launching, touching any window, or
# writing or deleting anything (a model-state reset is only reported).
#
# macOS is the supported platform (Terminal.app window handling by the caller).

set -uo pipefail

usage() {
  sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'
}
case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

# Keep custom fleet paths stable across Terminal's new shell and hook children.
FLEET_HOME="$(python3 -c 'import os,sys; print(os.path.abspath(os.path.expanduser(sys.argv[1])))' "${FLEET_HOME:-$HOME/.claude/telegram-fleet}")" || exit 2
export FLEET_HOME
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"

resolve_bin() {
  if [ -x "$FLEET_HOME/bin/$1" ]; then printf '%s\n' "$FLEET_HOME/bin/$1"; return; fi
  if [ -x "$SELF_DIR/$1" ]; then printf '%s\n' "$SELF_DIR/$1"; return; fi
  printf '%s\n' "$1"
}
FC_BIN="$(resolve_bin fleet-config)"
fc() { "$FC_BIN" "$@"; }
# Reject duplicate keys and shared/invalid paths before any lookup can choose a bot.
fc validate >/dev/null || { echo "Invalid fleet configuration; nothing acted on." >&2; exit 2; }
FLEET_CONFIG="$(fc path)" || exit 2
export FLEET_CONFIG

ARG="${1:-}"
RESUME_ID="${2:-}"

if [ -z "$ARG" ]; then
  echo "fleet-launch: need a bot key or workdir (try --help)" >&2
  exit 1
fi

# Accept a key or a workdir. Resolve to the canonical key first.
KEY="$(fc bot "$ARG" key 2>/dev/null || true)"
if [ -z "$KEY" ]; then
  KEY="$(fc bot-by-workdir "$ARG" key 2>/dev/null || true)"
fi
if [ -z "$KEY" ]; then
  echo "fleet-launch: '$ARG' is not a known bot key or workdir in fleet.json" >&2
  exit 1
fi

CWD="$(fc bot "$KEY" workdir)"
STATE_DIR="$(fc bot "$KEY" state_dir)"

# The resume argument reaches claude's own command line: only a session uuid or
# one of the fixed words above is accepted.
case "$RESUME_ID" in
  ""|continue|fresh-keep|fresh-reset) : ;;
  *)
    if ! [[ "$RESUME_ID" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
      echo "fleet-launch: resume argument '$(printf '%s' "$RESUME_ID" | LC_ALL=C tr -d '\000-\037\177' | cut -c1-80)' is not a session uuid, continue, fresh-keep or fresh-reset" >&2
      exit 2
    fi ;;
esac

if [ ! -d "$CWD" ]; then
  echo "fleet-launch: workdir missing: $CWD" >&2
  exit 1
fi

# --- env wiring -------------------------------------------------------------
if [ -f "$STATE_DIR/.env" ]; then
  bot_token=$(grep -E '^TELEGRAM_BOT_TOKEN=' "$STATE_DIR/.env" | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'" | tr -d '[:space:]')
  [ -n "$bot_token" ] && export TELEGRAM_BOT_TOKEN="$bot_token"
fi
export TELEGRAM_STATE_DIR="$STATE_DIR"
# Flicker-free renderer, scoped to this bot session only.
export CLAUDE_CODE_NO_FLICKER=1

# --- sticky per-bot model + effort ------------------------------------------
# MODEL is stored as a CLASS ALIAS (opus/sonnet/fable/haiku) or a literal
# claude-* id - never a pinned version - so an alias always resolves to the
# newest model in that class. Absent or invalid state = no flags = your Claude
# Code default (this tool never forces a model on you). Only
# fresh-reset resets to that default by removing the state file - after the
# dry-run guard below, so a dry run never deletes it.
MODEL_STATE_FILE="$STATE_DIR/model-state"
RESET_MODEL_STATE=0
case "$RESUME_ID" in fresh-reset) RESET_MODEL_STATE=1 ;; esac
BOT_MODEL=""; BOT_EFFORT=""
if [ "$RESET_MODEL_STATE" = "0" ] && [ -f "$MODEL_STATE_FILE" ]; then
  _m=$(grep -E '^MODEL='  "$MODEL_STATE_FILE" | head -1 | cut -d= -f2- | tr -d '[:space:]')
  _e=$(grep -E '^EFFORT=' "$MODEL_STATE_FILE" | head -1 | cut -d= -f2- | tr -d '[:space:]')
  case "$_m" in opus|sonnet|fable|haiku) BOT_MODEL="$_m" ;; claude-*) BOT_MODEL="$_m" ;; esac
  case "$_e" in low|medium|high|xhigh|max) BOT_EFFORT="$_e" ;; esac
fi

# --- permission stance ------------------------------------------------------
# $FLEET_HOME/permission-stance holds one of: safe | scoped | full.
#   safe   (default) no permission flag - Claude Code asks as usual
#   scoped --permission-mode auto
#   full   --dangerously-skip-permissions   (only if you explicitly chose it)
STANCE="safe"
if [ -f "$FLEET_HOME/permission-stance" ]; then
  _s=$(head -1 "$FLEET_HOME/permission-stance" | tr -d '[:space:]')
  case "$_s" in safe|scoped|full) STANCE="$_s" ;; esac
fi

# --- build the claude command ----------------------------------------------
ARGS=(--channels plugin:telegram@claude-plugins-official)
case "$RESUME_ID" in
  "")          RESUME_DESC="fresh" ;;
  fresh-reset) RESUME_DESC="fresh-reset" ;;
  continue)    ARGS+=(--continue); RESUME_DESC="continue" ;;
  fresh-keep)  RESUME_DESC="fresh-keep" ;;
  *)           ARGS+=(--resume "$RESUME_ID"); RESUME_DESC="resume $RESUME_ID" ;;
esac
[ -n "$BOT_MODEL" ]  && ARGS+=(--model "$BOT_MODEL")
[ -n "$BOT_EFFORT" ] && ARGS+=(--effort "$BOT_EFFORT")
case "$STANCE" in
  full)   ARGS+=(--dangerously-skip-permissions) ;;
  scoped) ARGS+=(--permission-mode auto) ;;
  safe)   : ;;
esac

echo "launching $KEY in $CWD (state: $STATE_DIR, model: ${BOT_MODEL:-default} effort: ${BOT_EFFORT:-default} stance: $STANCE $RESUME_DESC)"

if [ "${CC_LAUNCH_DRYRUN:-}" = "1" ]; then
  echo "DRYRUN key=$KEY cwd=$CWD argv: claude ${ARGS[*]}"
  if [ "$RESET_MODEL_STATE" = "1" ]; then
    echo "DRYRUN model-state would be reset to your default (nothing was deleted)"
  fi
  exit 0
fi

# The one and only model-state reset, never reached by a dry run.
if [ "$RESET_MODEL_STATE" = "1" ]; then
  rm -f "$MODEL_STATE_FILE" 2>/dev/null || true
fi

cd "$CWD" || { echo "fleet-launch: cannot cd to $CWD" >&2; exit 1; }

# Optional: ask the window-grid extra to tile all bot windows. Off by default;
# only when the grid option is on AND the extra is installed. Detached with a
# short delay so this window is a live claude session by the time it runs.
if [ "$(fc option grid 2>/dev/null || echo false)" = "true" ]; then
  GRID="$(resolve_bin fleet-grid)"
  if [ -x "$GRID" ]; then
    # $GRID must expand inside the child sh (passed via env), not out here.
    # shellcheck disable=SC2016
    GRID="$GRID" nohup sh -c 'sleep 3; exec "$GRID"' >/dev/null 2>&1 &
    disown 2>/dev/null || true
  fi
fi

# >>> clear-stale-telegram-mcp-failure (2026-09-27)
# Launch-side immunity to a "deaf restart". Any Claude Code session that loads the
# telegram plugin WITHOUT TELEGRAM_STATE_DIR (a headless `claude -p` job, or a bare
# `claude mcp list` / `claude mcp get` from a plain shell) makes the patched plugin
# exit on purpose (patches/01-state-dir-guard.patch), and Claude Code caches that
# failure in mcp-needs-auth-cache.json under "plugin:telegram:telegram". For the
# next 15 minutes every NEW session on the machine skips the plugin, so a bot
# launched in that window comes up with no poller and hears nothing. This removes
# ONLY that one key, right before claude starts: never the file, never another key.
# The write is atomic (temp file + rename, same mode). A missing, empty or invalid
# file just logs one line and the launch goes on. The path follows Claude Code's
# own (CLAUDE_CONFIG_DIR, else ~/.claude); an optional first argument overrides it
# for tests. Needs python3, which fleet-config already requires.
clear_stale_telegram_mcp_failure() {
  local cache="${1:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/mcp-needs-auth-cache.json}"
  local py=/usr/bin/python3
  [ -x "$py" ] || py="$(command -v python3 2>/dev/null || true)"
  if [ -z "$py" ]; then
    echo "mcp-cache: python3 not found - skipped the stale telegram entry check, launching anyway" >&2
    return 0
  fi
  "$py" - "$cache" <<'PY' || echo "mcp-cache: clear step exited $? - launching anyway" >&2
import json
import os
import sys
import tempfile
import time

KEY = "plugin:telegram:telegram"


def say(msg):
    sys.stderr.write("mcp-cache: " + msg + "\n")


def main(path):
    try:
        with open(path, "rb") as fh:
            raw = fh.read()
    except FileNotFoundError:
        say("no " + path + " - nothing to clear")
        return
    except OSError as exc:
        say("could not read " + path + " (" + type(exc).__name__ + ") - left as is, launching anyway")
        return
    if not raw.strip():
        say(path + " is empty - left as is, launching anyway")
        return
    try:
        data = json.loads(raw.decode("utf-8"))
    except ValueError:
        say(path + " is not valid JSON - left as is, launching anyway")
        return
    if not isinstance(data, dict):
        say(path + " is not a JSON object - left as is, launching anyway")
        return
    if KEY not in data:
        say("no stale " + KEY + " entry - nothing to clear")
        return
    entry = data.pop(KEY)
    age = ""
    ts = entry.get("timestamp") if isinstance(entry, dict) else None
    if isinstance(ts, (int, float)) and not isinstance(ts, bool):
        age = " (cached %ds ago)" % int(time.time() - ts / 1000.0)
    target = os.path.realpath(path)
    tmp = None
    try:
        mode = os.stat(target).st_mode & 0o7777
        fd, tmp = tempfile.mkstemp(prefix=".mcp-needs-auth-cache.", suffix=".tmp", dir=os.path.dirname(target))
        with os.fdopen(fd, "w", encoding="utf-8") as out:
            out.write(json.dumps(data, ensure_ascii=False, separators=(",", ":")))
            out.flush()
            os.fsync(out.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, target)
        tmp = None
    except OSError as exc:
        say("could not rewrite " + path + " (" + type(exc).__name__ + ") - left as is, launching anyway")
        return
    finally:
        if tmp is not None:
            try:
                os.unlink(tmp)
            except OSError:
                pass
    left = len(data)
    say("cleared a stale %s entry%s, kept %d other %s" % (KEY, age, left, "entry" if left == 1 else "entries"))


try:
    main(sys.argv[1])
except Exception as exc:
    say("clear step hit " + type(exc).__name__ + " - launching anyway")
sys.exit(0)
PY
  return 0
}
# <<< clear-stale-telegram-mcp-failure
clear_stale_telegram_mcp_failure

exec claude "${ARGS[@]}"
